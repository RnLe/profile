---
/**
 * Compact evidence strip: verified background facts, then the languages and
 * frameworks I actually build with (with their marks), spread over the full
 * width of the hero (the shared .spread row). The background stands on a
 * painted brush stroke, and a strong pipe marks where the tools begin; the
 * tools themselves keep their spacing without pipes.
 *
 * Narrower, the background takes a line of its own, centred, and the tools stay spread
 * on the next; narrowest, the tools wrap and the gaps alone separate them.
 */
import type { StripItem } from '../../data/site';
import Icon from '../ui/Icon.astro';

interface Props {
  items: StripItem[];
}

const { items } = Astro.props;
---

<div class="evidence-strip">
  <ul class="spread">
    {items.map((item, index) => (
      <>
        {index > 0 && (
          <li
            class:list={['sep', items[index - 1].register !== item.register && 'sep--register']}
            aria-hidden="true"
          >
            |
          </li>
        )}
        <li class:list={['item', item.register === 'background' && 'item--background']}>
          {item.icon && <Icon name={item.icon} size={16} />}
          <span>{item.label}</span>
        </li>
      </>
    ))}
  </ul>
</div>

<style>
  .evidence-strip {
    container: strip / inline-size;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 540;
    letter-spacing: 0.03em;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .item :global(svg) {
    color: var(--ink-faint);
  }

  /* The background, painted on: white on a rough stroke of the accent,
     tilted a little. The stroke is a mask, so it takes the accent's colour. */
  .item--background {
    position: relative;
    isolation: isolate;
    padding: 0.5em 1.35em;
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .item--background::before {
    content: '';
    position: absolute;
    inset: -0.15em -0.3em;
    z-index: -1;
    background: var(--accent);
    -webkit-mask: url('../../assets/brush-stroke.svg') center / 100% 100% no-repeat;
    mask: url('../../assets/brush-stroke.svg') center / 100% 100% no-repeat;
    transform: rotate(-2deg);
  }

  /* Between the tools the pipes keep their place but not their mark. */
  .sep:not(.sep--register) {
    visibility: hidden;
  }

  /* The change of register: a little larger, and bold. */
  .sep--register {
    font-size: 1.3em;
    font-weight: 700;
    line-height: 1;
    color: var(--ink-faint);
  }

  /* The background on a line of its own; the tools spread across the next.
     The register pipe becomes the line break, so the stroke keeps the width
     of its words instead of the row's. */
  @container strip (max-width: 34rem) {
    .spread {
      flex-wrap: wrap;
      row-gap: var(--sp-3);
    }

    .sep--register {
      flex-basis: 100%;
      block-size: 0;
      overflow: hidden;
      font-size: 0;
    }

    /* Alone on its line, the background sits in the middle of it. */
    .item--background {
      margin-inline: auto;
    }
  }

  /* A phone's width: the tools stay on one line, a size smaller and closer. */
  @container strip (max-width: 24rem) {
    .spread {
      column-gap: var(--sp-1);
    }

    .item:not(.item--background) {
      font-size: 0.75rem;
    }
  }

  /* Too narrow even so: the tools wrap, and the gaps alone separate them. */
  @container strip (max-width: 21rem) {
    .spread {
      justify-content: flex-start;
      column-gap: var(--sp-4);
    }

    .sep:not(.sep--register) {
      display: none;
    }
  }
</style>
