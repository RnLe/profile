---
/**
 * Hero portrait with a real signal-processing view.
 *
 * "Real" shows the photograph. "Fourier" runs an actual 2D FFT of its
 * luminance and stacks two squares: the live inverse transform on top and the
 * magnitude spectrum below it (paint on it). Painting removes the frequencies
 * under a fixed-size brush, mirrored to the conjugate bin so the
 * reconstruction stays real. A reset appears once anything has been painted,
 * and an info button explains the view in plain words.
 *
 * The whole instrument occupies one fixed square: both modes are absolutely
 * positioned layers inside it, and the labels and buttons sit in the margins
 * the two stacked squares leave free, so switching modes never moves anything
 * else on the page.
 *
 * Implemented as a plain module script rather than a React island: the hero is
 * the most performance-critical surface on the site, and a canvas painting
 * loop gains nothing from a virtual DOM.
 */
import { getImage } from 'astro:assets';
import portrait from '../../assets/Profile_Lehner.webp';
import { site } from '../../data/site';
import { nextId } from '../../lib/uid';
import Icon from '../ui/Icon.astro';
import Marked from '../ui/Marked.astro';

const WIDTH = 640;
const optimized = await getImage({ src: portrait, width: WIDTH, format: 'webp' });
const height = Math.round((WIDTH * portrait.height) / portrait.width);
const infoId = nextId('lab-info');
const infoText =
  'Bottom: the photo’s **Fourier transform**. Each point is a wave pattern, ==coarse at the centre, finer outwards==, and brighter the more the photo contains it. Top: the photo **rebuilt from those waves**. Paint on the bottom to remove waves: without the centre, ==only outlines remain==. JPEG compression rests on the same idea.';
---

<div class="portrait-lab" data-portrait-lab data-src={optimized.src}>
  <div class="stage">
    <div class="layer layer--real" data-layer="real">
      <img src={optimized.src} alt={`Portrait of ${site.name}`} width={WIDTH} {height} />
    </div>

    <div class="layer layer--fourier" data-layer="fourier" hidden>
      <figure class="pane">
        <canvas
          data-recon
          width="256"
          height="256"
          role="img"
          aria-label="The portrait rebuilt by an inverse transform from the spectrum below."></canvas>
        <figcaption>inverse FFT</figcaption>
      </figure>

      <figure class="pane">
        <div class="canvas-wrap" data-canvas-wrap>
          <canvas
            data-spectrum
            width="256"
            height="256"
            role="img"
            aria-label="Fourier magnitude of the portrait, log-scaled with the zero frequency at the centre. Paint on it to remove frequencies."></canvas>
          <span class="brush-ring" data-brush-ring aria-hidden="true"></span>
        </div>
        <figcaption>log magnitude</figcaption>
      </figure>

      {/* The explanation shows on hover and on keyboard focus, and a click or
          tap pins it open, since a touch screen has no hover. It is the
          button's description, so a screen reader reads it on focus. */}
      <div class="info" data-info>
        <button type="button" class="info-button" aria-label="About this view" aria-describedby={infoId}>
          <Icon name="info" size={18} />
        </button>
        <p class="info-pop marked" id={infoId}><Marked text={infoText} /></p>
      </div>

      <button type="button" class="reset" data-reset hidden>Reset</button>
    </div>
  </div>

  {/* Script capitals, the way the two views are written in maths. The glyph is
      decorative; the button's name stays the word, for assistive technology and
      for anything that searches the page. */}
  <div class="modes" role="group" aria-label="Portrait view">
    <button type="button" data-mode="real" aria-pressed="true">
      <span class="glyph" aria-hidden="true">&#8475;</span>
      <span class="visually-hidden">Real</span>
    </button>
    <button type="button" data-mode="fourier" aria-pressed="false">
      <span class="glyph" aria-hidden="true">&#8497;</span>
      <span class="visually-hidden">Fourier</span>
    </button>
  </div>

  {/* No visible caption: the mode buttons say what the two views are. The
      transform's progress and failure still need announcing, so they go to a
      screen-reader-only live region instead. */}
  <p class="visually-hidden" role="status" data-note></p>
</div>

<style>
  /* One fixed frame, whatever the mode: nothing below it ever moves. */
  .portrait-lab {
    --lab-size: 20.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    inline-size: min(var(--lab-size), 100%);
    margin-inline-start: auto;
  }

  [hidden] {
    display: none !important;
  }

  .stage {
    position: relative;
    aspect-ratio: 1;
  }

  .layer {
    position: absolute;
    inset: 0;
  }

  .layer--real img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  /*
   * Two squares, one above the other, as large as the frame's height allows.
   * The frame is square, so with the gap between them they fill it exactly
   * when each is half its width less half the gap. That leaves a margin on
   * each side: the labels take the left one, the buttons the right.
   */
  .layer--fourier {
    --pane-gap: var(--sp-2);
    --margin: calc(25% + var(--pane-gap) / 4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }

  .pane {
    position: relative;
    margin: 0;
    inline-size: calc(50% - var(--pane-gap) / 2);
  }

  .pane canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    background: #0b0e13;
  }

  /* Only the spectrum is painted on. Claiming the gesture on the read-only
     reconstruction above it would cost a vertical swipe over half the hero. */
  .pane canvas[data-spectrum] {
    touch-action: none;
  }

  .canvas-wrap {
    position: relative;
  }

  .canvas-wrap canvas {
    cursor: crosshair;
  }

  .brush-ring {
    position: absolute;
    border: 1px solid rgb(255 255 255 / 0.75);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .canvas-wrap:hover .brush-ring {
    opacity: 1;
  }

  /* Set along the left edge of its square and read upwards, like an axis
     label, so the squares can take the frame's full height. Physical offsets:
     the caption's own writing mode is vertical. */
  figcaption {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    margin-right: var(--sp-2);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--ink-faint);
  }

  /* ------------------------------------------------------------ controls --- */
  /* Centred in the right-hand margin: the right offset puts the button's centre
     half a margin in from the frame's edge. */
  .info-button,
  .reset {
    position: absolute;
    right: calc(var(--margin) / 2);
    transform: translateX(50%);
  }

  .info-button {
    top: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2rem;
    block-size: 2rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: none;
    color: var(--ink-faint);
    cursor: help;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .info-button:hover,
  .info[data-open] .info-button {
    color: var(--accent-strong);
  }

  .reset {
    bottom: 0;
  }

  /* Out of the flow, so the two squares stay the only things the layer lays
     out, and transparent to the pointer everywhere but on its two parts, so
     the spectrum under it can still be painted. */
  .info {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .info-button,
  .info-pop {
    pointer-events: auto;
  }

  .info-pop {
    position: absolute;
    top: calc(2rem + var(--sp-1));
    left: 0;
    right: 0;
    z-index: 2;
    margin: 0;
    padding: var(--sp-3);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-muted);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      visibility var(--dur-fast) var(--ease-out);
  }

  /* Hover is a pointer's affordance: a touch screen keeps it applied after a
     tap, so there the tap alone opens and closes the note. */
  @media (hover: hover) {
    .info:hover .info-pop {
      visibility: visible;
      opacity: 1;
    }
  }

  .info-button:focus-visible + .info-pop,
  .info[data-open] .info-pop {
    visibility: visible;
    opacity: 1;
  }

  /* Escape dismisses it without moving the pointer or the focus. */
  .info[data-dismissed] .info-pop {
    visibility: hidden;
    opacity: 0;
  }

  .modes {
    display: flex;
    gap: var(--sp-2);
  }

  .modes button,
  .reset {
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    min-height: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .modes button {
    flex: 1 1 0;
    justify-content: center;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--sp-4);
  }

  /* The margin beside the squares is about 4.5rem at its narrowest, so the
     reset keeps its padding tight. */
  .reset {
    padding: 0 var(--sp-2);
  }

  /* Letterlike Symbols are rare in UI faces, so ask for a face that has them
     before falling back; the browser substitutes per glyph either way. */
  .glyph {
    font-family: 'Cambria Math', 'STIX Two Math', 'Latin Modern Math', Cambria, Georgia, serif;
    font-size: 1.35rem;
    line-height: 1;
  }

  .modes button:hover,
  .reset:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .modes button[aria-pressed='true'] {
    background: var(--accent-wash);
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  /* A finger needs the 44 px guideline. The mode buttons sit below the frame,
     and the info and reset buttons in a margin that is wider than 44 px down
     to the narrowest phone, so all of them can take it. */
  @media (pointer: coarse) {
    .modes button,
    .reset {
      min-height: 2.75rem;
    }

    .info-button {
      inline-size: 2.75rem;
      block-size: 2.75rem;
    }

    .info-pop {
      top: calc(2.75rem + var(--sp-1));
    }
  }

  @media (max-width: 63.99rem) {
    .portrait-lab {
      margin-inline-start: 0;
    }
  }

  /* On a phone the column is narrower than the frame's own cap, so the cap
     only ever left a gap down one side of it. It takes the full width. */
  @media (max-width: 40rem) {
    .portrait-lab {
      inline-size: 100%;
      margin-inline: auto;
    }

    /* The first screen is tight here: the two mode buttons give up the
       44 px guideline for a slim row. Each is half the square wide, so a
       finger still finds it. */
    .modes button {
      min-height: 1.875rem;
    }

    .glyph {
      font-size: 1.15rem;
    }

    /* The square can be small here, which would leave the note a narrow
       column: it takes the page's width instead, centred on the square. */
    .info-pop {
      left: 50%;
      right: auto;
      inline-size: min(22rem, calc(100vw - 2 * var(--gutter)));
      transform: translateX(-50%);
    }
  }
</style>

<script>
  import { FFT2D, shiftTable } from '../../lib/fft';

  const N = 256;
  /** Brush radius in spectrum bins. */
  const BRUSH = 14;

  function setupPortraitLab(root: HTMLElement): void {
    const el = <T extends Element>(sel: string) => root.querySelector<T>(sel);

    const spectrumCanvas = el<HTMLCanvasElement>('[data-spectrum]');
    const reconCanvas = el<HTMLCanvasElement>('[data-recon]');
    const canvasWrap = el<HTMLElement>('[data-canvas-wrap]');
    const brushRing = el<HTMLElement>('[data-brush-ring]');
    const note = el<HTMLElement>('[data-note]');
    const reset = el<HTMLButtonElement>('[data-reset]');
    const info = el<HTMLElement>('[data-info]');
    const layers = {
      real: el<HTMLElement>('[data-layer="real"]'),
      fourier: el<HTMLElement>('[data-layer="fourier"]'),
    };

    if (!spectrumCanvas || !reconCanvas) return;

    const spectrumCtx = spectrumCanvas.getContext('2d');
    const reconCtx = reconCanvas.getContext('2d');
    if (!spectrumCtx || !reconCtx) return;

    const fft = new FFT2D(N);
    const shift = shiftTable(N);
    const total = N * N;

    /** Unshifted spectrum of the source luminance (computed once). */
    let specRe: Float64Array | null = null;
    let specIm: Float64Array | null = null;
    /** Log-magnitude, normalized to 0..1, unshifted. */
    let baseMag: Float32Array | null = null;
    /** Per-frequency multiplier, unshifted; 1 means untouched. */
    const mask = new Float32Array(total).fill(1);
    const workRe = new Float64Array(total);
    const workIm = new Float64Array(total);
    const spectrumImage = spectrumCtx.createImageData(N, N);
    const reconImage = reconCtx.createImageData(N, N);

    let loading = false;
    let frame = 0;
    let needsSpectrumDraw = false;
    let needsRecon = false;

    /* ------------------------------------------------------------ compute --- */

    const computeSpectrum = async (src: string): Promise<void> => {
      const image = new Image();
      image.decoding = 'async';
      image.src = src;
      await image.decode();

      const scratch = document.createElement('canvas');
      scratch.width = N;
      scratch.height = N;
      const scratchCtx = scratch.getContext('2d', { willReadFrequently: true });
      if (!scratchCtx) throw new Error('2D context unavailable');

      // Square crop, biased upward so the face fills the frame should the
      // source ever be taller than it is wide.
      const side = Math.min(image.naturalWidth, image.naturalHeight);
      const sx = (image.naturalWidth - side) / 2;
      const sy = (image.naturalHeight - side) * 0.12;
      scratchCtx.drawImage(image, sx, sy, side, side, 0, 0, N, N);
      const { data } = scratchCtx.getImageData(0, 0, N, N);

      const re = new Float64Array(total);
      const im = new Float64Array(total);
      for (let i = 0; i < total; i += 1) {
        const p = i * 4;
        // Rec. 709 luminance, normalized.
        re[i] = (0.2126 * data[p] + 0.7152 * data[p + 1] + 0.0722 * data[p + 2]) / 255;
      }
      fft.forward(re, im);
      specRe = re;
      specIm = im;

      const mag = new Float32Array(total);
      let peak = 0;
      for (let i = 0; i < total; i += 1) {
        const value = Math.log1p(Math.hypot(re[i], im[i]));
        mag[i] = value;
        if (value > peak) peak = value;
      }
      const norm = peak > 0 ? 1 / peak : 1;
      for (let i = 0; i < total; i += 1) mag[i] *= norm;
      baseMag = mag;
    };

    const drawSpectrum = (): void => {
      if (!baseMag) return;
      const pixels = spectrumImage.data;
      for (let y = 0; y < N; y += 1) {
        const v = shift[y];
        for (let x = 0; x < N; x += 1) {
          const source = v * N + shift[x];
          // Gamma lift so the mid-range structure stays readable.
          const value = Math.pow(baseMag[source] * mask[source], 0.85);
          const p = (y * N + x) * 4;
          pixels[p] = value * 232;
          pixels[p + 1] = value * 240;
          pixels[p + 2] = value * 255;
          pixels[p + 3] = 255;
        }
      }
      spectrumCtx.putImageData(spectrumImage, 0, 0);
    };

    const drawReconstruction = (): void => {
      if (!specRe || !specIm) return;
      for (let i = 0; i < total; i += 1) {
        const m = mask[i];
        workRe[i] = specRe[i] * m;
        workIm[i] = specIm[i] * m;
      }
      fft.inverse(workRe, workIm);

      const pixels = reconImage.data;
      for (let i = 0; i < total; i += 1) {
        let value = workRe[i] * 255;
        value = value < 0 ? 0 : value > 255 ? 255 : value;
        const p = i * 4;
        pixels[p] = value;
        pixels[p + 1] = value;
        pixels[p + 2] = value;
        pixels[p + 3] = 255;
      }
      reconCtx.putImageData(reconImage, 0, 0);
    };

    const schedule = (): void => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (!root.isConnected) return;
        if (needsSpectrumDraw) {
          needsSpectrumDraw = false;
          drawSpectrum();
        }
        if (needsRecon) {
          needsRecon = false;
          drawReconstruction();
        }
      });
    };

    /* -------------------------------------------------------------- paint --- */

    const paintAt = (clientX: number, clientY: number): void => {
      const rect = spectrumCanvas.getBoundingClientRect();
      const cx = Math.round(((clientX - rect.left) / rect.width) * N);
      const cy = Math.round(((clientY - rect.top) / rect.height) * N);
      const r2 = BRUSH * BRUSH;

      for (let dy = -BRUSH; dy <= BRUSH; dy += 1) {
        const y = cy + dy;
        if (y < 0 || y >= N) continue;
        for (let dx = -BRUSH; dx <= BRUSH; dx += 1) {
          if (dx * dx + dy * dy > r2) continue;
          const x = cx + dx;
          if (x < 0 || x >= N) continue;
          const u = shift[x];
          const v = shift[y];
          mask[v * N + u] = 0;
          // Mirror onto the conjugate bin so the inverse stays real-valued.
          mask[((N - v) % N) * N + ((N - u) % N)] = 0;
        }
      }
      reset?.removeAttribute('hidden');
      needsSpectrumDraw = true;
      needsRecon = true;
      schedule();
    };

    const moveBrushRing = (clientX: number, clientY: number): void => {
      if (!brushRing || !canvasWrap) return;
      const rect = spectrumCanvas.getBoundingClientRect();
      const diameter = BRUSH * 2 * (rect.width / N);
      brushRing.style.width = `${diameter}px`;
      brushRing.style.height = `${diameter}px`;
      brushRing.style.left = `${clientX - rect.left}px`;
      brushRing.style.top = `${clientY - rect.top}px`;
    };

    let painting = false;

    spectrumCanvas.addEventListener('pointerdown', (event) => {
      if (!specRe) return;
      painting = true;
      spectrumCanvas.setPointerCapture(event.pointerId);
      paintAt(event.clientX, event.clientY);
    });

    spectrumCanvas.addEventListener('pointermove', (event) => {
      moveBrushRing(event.clientX, event.clientY);
      if (painting) paintAt(event.clientX, event.clientY);
    });

    const stopPainting = (event: PointerEvent) => {
      painting = false;
      if (spectrumCanvas.hasPointerCapture(event.pointerId)) {
        spectrumCanvas.releasePointerCapture(event.pointerId);
      }
    };
    spectrumCanvas.addEventListener('pointerup', stopPainting);
    spectrumCanvas.addEventListener('pointercancel', stopPainting);

    /* ------------------------------------------------------------ controls --- */

    const setMode = async (next: 'real' | 'fourier'): Promise<void> => {
      root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.mode === next));
      });

      const fourier = next === 'fourier';
      layers.real?.toggleAttribute('hidden', fourier);
      layers.fourier?.toggleAttribute('hidden', !fourier);
      info?.removeAttribute('data-open');
      if (note) note.textContent = '';

      if (!fourier || specRe || loading) return;

      loading = true;
      if (note) note.textContent = 'Transforming the portrait…';
      try {
        await computeSpectrum(root.dataset.src ?? '');
        needsSpectrumDraw = true;
        needsRecon = true;
        schedule();
        if (note) note.textContent = 'Fourier view ready.';
      } catch {
        if (note) note.textContent = 'The transform could not run in this browser.';
        layers.real?.toggleAttribute('hidden', false);
        layers.fourier?.toggleAttribute('hidden', true);
      } finally {
        loading = false;
      }
    };

    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) => {
      button.addEventListener('click', () => {
        void setMode(button.dataset.mode === 'fourier' ? 'fourier' : 'real');
      });
    });

    reset?.addEventListener('click', () => {
      mask.fill(1);
      needsSpectrumDraw = true;
      needsRecon = true;
      schedule();
      // The button leaves with the edits. Focus would fall to the page, so it
      // moves to the pressed mode button: the info button would open its note.
      reset.setAttribute('hidden', '');
      root.querySelector<HTMLButtonElement>('[data-mode="fourier"]')?.focus();
      if (note) note.textContent = 'Portrait restored.';
    });

    if (info) {
      const infoButton = info.querySelector<HTMLButtonElement>('button');
      const undismiss = () => info.removeAttribute('data-dismissed');
      const showing = () =>
        info.hasAttribute('data-open') ||
        info.matches(':hover') ||
        Boolean(infoButton?.matches(':focus-visible'));

      infoButton?.addEventListener('click', () => {
        undismiss();
        info.toggleAttribute('data-open');
      });
      // Leaving the button and the note together, not just the button.
      info.addEventListener('pointerleave', undismiss);
      infoButton?.addEventListener('blur', undismiss);

      // The document outlives this page under client-side navigation, so its
      // listeners go with the page rather than piling up on every return.
      const listeners = new AbortController();
      const { signal } = listeners;
      document.addEventListener(
        'pointerdown',
        (event) => {
          if (!info.contains(event.target as Node)) info.removeAttribute('data-open');
        },
        { signal },
      );
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape' || layers.fourier?.hidden || !showing()) return;
          info.removeAttribute('data-open');
          info.setAttribute('data-dismissed', '');
        },
        { signal },
      );
      // A tap-scroll starting on the note itself is no pointerdown outside it.
      window.addEventListener('scroll', () => info.removeAttribute('data-open'), {
        capture: true,
        passive: true,
        signal,
      });
      document.addEventListener('astro:before-swap', () => listeners.abort(), { once: true });
    }
  }

  function initPortraitLabs(): void {
    document
      .querySelectorAll<HTMLElement>('[data-portrait-lab]:not([data-ready])')
      .forEach((root) => {
        root.dataset.ready = 'true';
        setupPortraitLab(root);
      });
  }

  document.addEventListener('astro:page-load', initPortraitLabs);
</script>
