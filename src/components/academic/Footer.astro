---
/**
 * The site's single contact surface. Pages used to repeat these details in a
 * "Get in touch" band, which said the same thing twice on every scroll to the
 * bottom; the footer now carries them alone and owns the `#contact` anchor
 * that the legacy /contact/ alias points at.
 */
import { emailDisplay, site } from '../../data/site';
import Icon from '../ui/Icon.astro';

const updated = new Date(`${site.lastUpdated}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<footer id="contact">
  <div class="wrap inner">
    <div class="who">
      <p class="name">{site.name}</p>
      <p class="place"><Icon name="map-pin" size={13} /> {site.location}</p>
    </div>

    <ul class="links">
      <li>
        <a href={`mailto:${site.email}`}><Icon name="mail" size={14} /> {emailDisplay}</a>
      </li>
      <li>
        <a href={site.github} rel="noopener">
          <Icon name="github" size={14} /> github.com/{site.githubUser}
        </a>
      </li>
      <li>
        <a href={site.linkedin} rel="noopener"><Icon name="linkedin" size={14} /> LinkedIn</a>
      </li>
    </ul>
  </div>

  <div class="wrap">
    <p class="fineprint">© 2026 {site.name} · Content last updated {updated}</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    background: var(--surface-alt);
    margin-block-start: var(--sp-16);
    padding-block: var(--sp-8) var(--sp-6);
    scroll-margin-block-start: var(--header-h);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-5) var(--sp-10);
  }

  .name {
    font-weight: 640;
    letter-spacing: -0.01em;
  }

  .place,
  .links {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .place {
    margin-block-start: var(--sp-1);
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
  }

  .place,
  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .fineprint {
    margin-block-start: var(--sp-6);
    border-top: 1px solid var(--line);
    padding-block-start: var(--sp-3);
    max-width: none;
    font-size: var(--step--2);
    color: var(--ink-faint);
  }
</style>
