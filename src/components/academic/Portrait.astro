---
/**
 * Configurable portrait: the professional portrait by default;
 * other sources and crops pass through props once they exist.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import professional from '../../assets/Profile_Lehner.webp';
import { site } from '../../data/site';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  widths?: number[];
  sizes?: string;
  /** Academic portraits render 4:5. */
  ratio?: string;
}

const {
  src = professional,
  alt = `Portrait of ${site.name}`,
  widths = [480, 720, 1080],
  sizes = '(max-width: 48rem) 80vw, 380px',
  ratio = '4 / 5',
} = Astro.props;
---

<div class="portrait-frame" style={`aspect-ratio: ${ratio};`}>
  <Image class="portrait" src={src} widths={widths} sizes={sizes} alt={alt} />
</div>

<style>
  .portrait-frame {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
    background: var(--surface);
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
