---
/**
 * The grokking test on 1,000 training faces (simple CNN, Omnigrok's recipe):
 * training accuracy (dashed) reaches 100% within 1,500 steps, validation
 * accuracy (solid) keeps rising long after. Large initial weights (3x, red)
 * start lower and rise later; without weight decay (dotted) the gain fades.
 */
import grok from '../../data/fer/grok.json';
import Plot from './Plot.astro';

type Run = { step: number[]; train_accuracy: number[]; val_accuracy: number[] };
const g = grok as Record<string, Run>;
const pts = (r: Run, k: 'train_accuracy' | 'val_accuracy') => r.step.map((s, i) => [s, r[k][i]] as [number, number]);
const a3 = g['cnn/a3_wd0.1'];
const a1 = g['cnn/a1_wd0.1'];
const a0 = g['cnn/a3_wd0'];
const mem = a3.step.find((s, i) => a3.train_accuracy[i] >= 0.999)!;
const low = Math.min(...a3.val_accuracy.filter((_, i) => a3.step[i] >= mem));
const peakV = Math.max(...a3.val_accuracy);
const half = a3.step.find((s, i) => s >= mem && a3.val_accuracy[i] >= (low + peakV) / 2)!;
const halfV = a3.val_accuracy[a3.step.indexOf(half)];
const end = a3.val_accuracy.at(-1)!;
const atMem = a3.val_accuracy[a3.step.indexOf(mem)];
---

<Plot
  id="fer-grok"
  label={`Grokking test on 1,000 faces: training accuracy reaches 100% by step ${mem.toLocaleString('en-US')}; validation accuracy of the large start rises from ${(atMem * 100).toFixed(0)}% to ${(end * 100).toFixed(0)}% long after, half of it by step ${half.toLocaleString('en-US')}.`}
  x={{ log: true, label: 'training steps (log scale)', min: 10, max: 1e5 }}
  y={{ percent: true, min: 0.2, max: 1.02, ticks: [0.2, 0.4, 0.6, 0.8, 1] }}
  series={[
    { label: 'normal start, train', color: '#7d8790', dash: '5 3', points: pts(a1, 'train_accuracy'), width: 1.3 },
    { label: 'normal start, validation', color: '#7d8790', width: 2, points: pts(a1, 'val_accuracy') },
    { label: '3× start, train', color: '#b4503a', dash: '5 3', points: pts(a3, 'train_accuracy'), width: 1.3 },
    { label: '3× start, validation', color: '#b4503a', width: 2.2, points: pts(a3, 'val_accuracy') },
    { label: '3× start, no weight decay', color: '#b4503a', dash: '1.5 3', width: 1.6, points: pts(a0, 'val_accuracy') },
  ]}
  annotations={[
    { kind: 'band', x: mem, x2: 1e5, color: 'rgb(180 80 58 / 0.05)' },
    { kind: 'vline', x: mem },
    { kind: 'label', x: mem, y: 0.24, dx: 6, text: `memorised (step ${mem.toLocaleString('en-US')})`, anchor: 'start', color: 'var(--ink-muted)' },
    { kind: 'point', x: half, y: halfV, dx: -14, dy: 34, text: 'half of the rise', anchor: 'end' },
    { kind: 'label', x: 6e4, y: end, dy: -12, text: `+${((end - atMem) * 100).toFixed(0)} points`, color: '#b4503a' },
  ]}
  height={330}
  width={600}
/>
