---
/**
 * Training curves of the seven architectures with their default settings
 * (mean of two seeds, 60 epochs): validation accuracy and validation loss.
 * The learning rate decays to zero along a cosine, so every curve settles at
 * the end; none turns back up, so there is no overfitting to mark.
 */
import models from '../../data/fer/models.json';
import Plot from './Plot.astro';
import { MODEL_COLORS, MODEL_NAMES } from './plot';

type Curve = { val_accuracy: number[]; val_loss: number[]; train_accuracy: number[] };
const base = models.baseline as Record<string, Curve & { test: number }>;
const order = ['resnet', 'vgg', 'densenet', 'cct', 'cnn', 'convnext', 'vit'];
const line = (key: keyof Curve) =>
  order.map((m) => ({
    label: MODEL_NAMES[m],
    color: MODEL_COLORS[m],
    width: ['resnet', 'vgg', 'densenet'].includes(m) ? 2 : 1.4,
    points: base[m][key].map((v, i) => [i + 1, v] as [number, number]),
  }));
const resnet = base.resnet;
const gapAt = resnet.train_accuracy.length;
---

<div class="pair">
  <Plot
    id="fer-curves-acc"
    title="Validation accuracy"
    label="Validation accuracy per epoch for the seven architectures with default settings; the curves rise fast in the first ten epochs and settle as the learning rate decays."
    x={{ label: 'epoch', min: 1, max: 60, ticks: [1, 10, 20, 30, 40, 50, 60] }}
    y={{ percent: true, min: 0.3, max: 0.9 }}
    series={line('val_accuracy')}
    annotations={[{ kind: 'label', x: 46, y: 0.4, text: 'learning rate decays\nto zero (cosine)', anchor: 'middle', color: 'var(--ink-muted)' }]}
    legend={false}
    height={260}
  />
  <Plot
    id="fer-curves-loss"
    title="Validation loss"
    label="Validation loss per epoch for the seven architectures; it falls and flattens without turning back up."
    x={{ label: 'epoch', min: 1, max: 60, ticks: [1, 10, 20, 30, 40, 50, 60] }}
    y={{ min: 0.4, max: 1.6 }}
    series={line('val_loss')}
    annotations={[{ kind: 'point', x: gapAt, y: resnet.val_loss.at(-1)!, dx: -30, dy: -34, text: 'no upturn:\nno overfitting', anchor: 'end', color: 'var(--ink-heading)' }]}
    height={260}
  />
</div>

<style>
  .pair {
    display: grid;
    gap: var(--sp-6);
  }

  @container (min-width: 46rem) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: end;
    }
  }
</style>
