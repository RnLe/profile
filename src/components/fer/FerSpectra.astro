---
/**
 * Why output-based compression works: the share of a layer's variance held
 * by its leading directions, for the weights (dashed) and for the outputs
 * (solid), in VGG's last convolution and an early one.
 */
import compress from '../../data/fer/compress.json';
import Plot from './Plot.astro';

type Spec = { channels: number; weights: number[]; outputs: number[] };
const spectra = compress.spectra as Record<string, Spec>;
const at95 = (v: number[]) => v.findIndex((x) => x >= 0.95) + 1;
const last = spectra['features.36'];
const early = spectra['features.3'];
const curve = (v: number[]) => v.map((x, i) => [i + 1, x] as [number, number]);
---

<Plot
  id="fer-spectra"
  label={`Cumulative share of variance against the number of directions. In VGG's last convolution, ${at95(last.outputs)} of ${last.channels} directions hold 95% of the outputs, but the weights need ${at95(last.weights)}.`}
  x={{ log: true, label: 'number of directions kept (log scale)', min: 1, max: 616, ticks: [1, 2, 5, 10, 20, 50, 100, 200, 500] }}
  y={{ percent: true, min: 0, max: 1.02, ticks: [0, 0.25, 0.5, 0.75, 0.95] }}
  series={[
    { label: 'last conv, outputs', color: '#2f6db0', width: 2.2, points: curve(last.outputs) },
    { label: 'last conv, weights', color: '#2f6db0', dash: '5 3', width: 1.6, points: curve(last.weights) },
    { label: 'early conv, outputs', color: '#7d8790', width: 1.8, points: curve(early.outputs) },
    { label: 'early conv, weights', color: '#7d8790', dash: '5 3', width: 1.4, points: curve(early.weights) },
  ]}
  annotations={[
    { kind: 'hline', y: 0.95 },
    { kind: 'point', x: at95(last.outputs), y: 0.95, dx: 18, dy: 40, text: `${at95(last.outputs)} of ${last.channels}`, anchor: 'start' },
    { kind: 'point', x: at95(last.weights), y: 0.95, dx: -14, dy: 42, text: `${at95(last.weights)} of ${last.channels}`, anchor: 'end' },
  ]}
  height={310}
  width={460}
/>
