---
/**
 * Horizontal bars for the facial emotion study: one row per category, its
 * parts either stacked or side by side, the value written at the end. Legend
 * in HTML under the drawing.
 */
import { format, scale, type AxisSpec } from './plot';

export interface Part {
  label: string;
  color: string;
}

interface Phone {
  width?: number;
  rowHeight?: number;
  labelWidth?: number;
  right?: number;
  x?: Partial<AxisSpec>;
}

interface Props {
  label: string;
  rows: { label: string; values: number[]; note?: string; strong?: boolean }[];
  parts: Part[];
  stacked?: boolean;
  x: AxisSpec;
  width?: number;
  rowHeight?: number;
  /** Width kept for the row labels. */
  labelWidth?: number;
  /** Room on the right for the value at the bar's end. */
  right?: number;
  /** Format of the value at the bar's end (the stack's total). */
  value?: AxisSpec;
  /** A reference value drawn as a dashed line, e.g. the uncompressed model. */
  reference?: { at: number; text: string };
  /** The smallest the drawing may shrink to before it scrolls sideways. */
  minScale?: number;
  /**
   * A second, narrower drawing for a phone (a container under 26rem), with
   * larger text: its own width (default 360), row height, label width and
   * axis, each falling back to the wide drawing's.
   */
  phone?: Phone | true;
}

const { label, rows, parts, stacked = true, x: xAxis, width = 560, rowHeight = 26, labelWidth = 92, right = 52, value: valueSpec, reference, minScale = 0.72, phone } = Astro.props;
/** Below this container width the phone drawing replaces the wide one. */
const PHONE_BELOW = 416;
/** The narrowest column a chart is given (a 320 px screen); wider minimums scroll. */
const NARROWEST = 288;
const value = valueSpec ?? xAxis;
const totals = rows.map((r) => (stacked ? r.values.reduce((a, b) => a + b, 0) : Math.max(...r.values)));

interface Variant {
  key: 'wide' | 'phone';
  width: number;
  rowHeight: number;
  labelWidth: number;
  right: number;
  xs: AxisSpec;
  minWidth: number;
}
const variants: Variant[] = [{ key: 'wide', width, rowHeight, labelWidth, right, xs: xAxis, minWidth: Math.round(width * minScale) }];
if (phone) {
  const p = phone === true ? {} : phone;
  variants[0].minWidth = Math.min(variants[0].minWidth, PHONE_BELOW);
  variants.push({ key: 'phone', width: p.width ?? 360, rowHeight: p.rowHeight ?? rowHeight, labelWidth: p.labelWidth ?? labelWidth, right: p.right ?? right, xs: { ...xAxis, ...p.x }, minWidth: 0 });
}

function layout(v: Variant) {
  const groupH = stacked ? v.rowHeight : v.rowHeight * parts.length * 0.62 + 8;
  const top = reference ? (v.key === 'phone' ? 22 : 16) : 6;
  const height = top + rows.length * groupH + (v.xs.label ? 36 : 22);
  const X = scale([0, ...totals, ...(v.xs.max != null ? [v.xs.max] : []), ...(reference ? [reference.at] : [])], { ...v.xs, min: v.xs.min ?? 0 }, v.labelWidth, v.width - v.right, 0.02);
  return { groupH, top, height, X, plotBottom: top + rows.length * groupH };
}
const regionName = `${label.split('. ')[0]}, scrolls sideways`;
---

<div class:list={['fer-bars', phone && 'has-phone']} style={`max-width:${Math.round(width * 1.4)}px`}>
  {variants.map((v) => {
    const { groupH, top, height, X, plotBottom } = layout(v);
    const { width: w, labelWidth: lw, xs } = v;
    const scrolls = v.minWidth > NARROWEST;
    return (
      <div class={`scroll variant--${v.key}`} {...(scrolls ? { tabindex: 0, role: 'group', 'aria-label': regionName } : {})}>
      <svg viewBox={`0 0 ${w} ${height}`} role="img" aria-label={label} style={v.minWidth ? `min-width:${v.minWidth}px` : undefined}>
        <g class="grid">
          {X.ticks.map((t) => <line x1={X(t)} x2={X(t)} y1={top} y2={plotBottom} />)}
        </g>
        {rows.map((row, i) => {
          const y0 = top + i * groupH;
          let acc = 0;
          return (
            <g>
              <text class:list={['row-label', row.strong && 'strong']} x={lw - 8} y={y0 + groupH / 2 + 4} text-anchor="end">{row.label}</text>
              {stacked
                ? row.values.map((val, k) => {
                    const x0 = X(acc);
                    acc += val;
                    return (
                      <rect x={x0} y={y0 + 4} width={Math.max(0, X(acc) - x0)} height={groupH - 8} fill={parts[k].color} rx="2">
                        <title>{`${row.label}, ${parts[k].label}: ${format(val, value)}`}</title>
                      </rect>
                    );
                  })
                : row.values.map((val, k) => {
                    const hh = (groupH - 8) / parts.length;
                    if (!Number.isFinite(val)) {
                      return <text class="value" x={X(0) + 5} y={y0 + 4 + k * hh + hh / 2 + 2.5}>n/a</text>;
                    }
                    return (
                      <g>
                        <rect x={X(0)} y={y0 + 4 + k * hh} width={Math.max(0, X(val) - X(0))} height={hh - 2} fill={parts[k].color} rx="2">
                          <title>{`${row.label}, ${parts[k].label}: ${format(val, value)}`}</title>
                        </rect>
                        <text class="value" x={X(val) + 5} y={y0 + 4 + k * hh + hh / 2 + 2.5}>{format(val, value)}</text>
                      </g>
                    );
                  })}
              {stacked && (
                <text class="value" x={X(totals[i]) + 5} y={y0 + groupH / 2 + 4}>{row.note ?? format(totals[i], value)}</text>
              )}
            </g>
          );
        })}
        {reference && (
          <g class="reference">
            <line x1={X(reference.at)} x2={X(reference.at)} y1={top - 6} y2={plotBottom} />
            <text x={X(reference.at)} y={top - 8} text-anchor="middle">{reference.text}</text>
          </g>
        )}
        <line class="axis" x1={lw} x2={lw} y1={top} y2={plotBottom} />
        <g class="ticks">
          {X.ticks.map((t) => <text x={X(t)} y={plotBottom + 14} text-anchor="middle">{format(t, xs, X.ticks)}</text>)}
        </g>
        {xs.label && <text class="axis-label" x={(lw + w - v.right) / 2} y={height - 6} text-anchor="middle">{xs.label}</text>}
      </svg>
      </div>
    );
  })}
  {parts.length > 1 && (
    <ul class="legend">
      {parts.map((p) => (
        <li><span class="swatch" style={`background:${p.color}`} />{p.label}</li>
      ))}
    </ul>
  )}
</div>

<style>
  .fer-bars {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    min-width: 0;
    container: fer-bars / inline-size;
  }

  .variant--phone {
    display: none;
  }

  /* 26rem: the phone drawing's breakpoint (PHONE_BELOW). */
  @container fer-bars (max-width: 25.99rem) {
    .has-phone > .variant--wide {
      display: none;
    }

    .has-phone > .variant--phone {
      display: block;
    }
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .scroll:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  .grid line {
    stroke: var(--line);
    stroke-width: 0.8;
  }

  .axis {
    stroke: var(--line-strong);
  }

  .row-label {
    font-size: 12px;
    fill: var(--ink);
  }

  .row-label.strong {
    font-weight: 650;
  }

  .value,
  .ticks text,
  .axis-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-muted);
  }

  .ticks text {
    fill: var(--ink-faint);
  }

  .reference line {
    stroke: var(--ink-heading);
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }

  .reference text {
    font-size: 10.5px;
    font-weight: 600;
    fill: var(--ink-heading);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .swatch {
    display: inline-block;
    inline-size: 0.8rem;
    block-size: 0.6rem;
    border-radius: 2px;
  }

  .variant--phone .row-label {
    font-size: 14px;
  }

  .variant--phone .value,
  .variant--phone .ticks text,
  .variant--phone .axis-label,
  .variant--phone .reference text {
    font-size: 13px;
  }

  @media (max-width: 40rem) {
    .row-label {
      font-size: 13.5px;
    }

    .value,
    .ticks text,
    .axis-label,
    .reference text {
      font-size: 12.5px;
    }
  }
</style>
