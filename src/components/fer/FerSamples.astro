---
/**
 * Eight random training faces per class, from FER2013 only: RAF-DB images
 * may not be redistributed. 48 × 48 pixels, grayscale.
 */
import { Image } from 'astro:assets';
import samples from '../../assets/fer/samples.png';
import { CLASSES } from './plot';
---

<div class="fer-samples">
  <ul class="labels" aria-hidden="true">
    {CLASSES.map((c) => <li>{c}</li>)}
  </ul>
  <Image
    src={samples}
    alt="A grid of 56 small grayscale faces from FER2013, eight per row, one row per emotion: angry, disgust, fear, happy, neutral, sad, surprise"
    widths={[384, 768]}
    sizes="(max-width: 40rem) 80vw, 384px"
  />
</div>

<style>
  .fer-samples {
    display: grid;
    grid-template-columns: auto minmax(0, 24rem);
    gap: var(--sp-3);
    align-items: stretch;
  }

  .labels {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    text-align: end;
  }

  .labels li {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .fer-samples :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--r-sm);
  }
</style>
