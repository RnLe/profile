---
/**
 * A run of copy with its light emphasis (src/lib/marks.ts) as <strong>,
 * <mark>, links, and monospace labels. Styled by the .marked class on an ancestor (global.css).
 */
import { runs } from '../../lib/marks';
import { withBase } from '../../lib/routes';
import { glue } from '../../lib/typography';

interface Props {
  text: string;
}

const { text } = Astro.props;
const href = (target: string) => (target.startsWith('/') ? withBase(target) : target);
---

{runs(text).map((run) =>
  run.kind === 'strong' ? (
    <strong>{glue(run.text)}</strong>
  ) : run.kind === 'mark' ? (
    <mark>{glue(run.text)}</mark>
  ) : run.kind === 'label' ? (
    <span class="mono-label">{glue(run.text)}</span>
  ) : run.kind === 'link' ? (
    <a href={href(run.href!)} rel={run.href!.startsWith('/') ? undefined : 'noopener'}>{glue(run.text)}</a>
  ) : (
    glue(run.text)
  ),
)}
