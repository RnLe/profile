---
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  expr: string;
  display?: boolean;
}

const { expr, display = false } = Astro.props;
const html = katex.renderToString(expr, {
  displayMode: display,
  throwOnError: true,
  output: 'htmlAndMathml',
});
---

<Fragment set:html={html} />
