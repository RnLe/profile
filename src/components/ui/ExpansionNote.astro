---
/**
 * The one place that says this site is still growing: a short band at the
 * end of the landing page, with the site's light emphasis.
 */
import Icon from './Icon.astro';
import Marked from './Marked.astro';

const copy =
  'This portfolio is ==still growing==: more projects, case studies, and documents are on the way. What is here today is **complete as it stands**.';
---

<div class="note">
  <Icon name="arrow-right" size={15} />
  <p class="marked"><Marked text={copy} /></p>
</div>

<style>
  .note {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-5);
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface-alt);
    color: var(--ink-muted);
  }

  .note :global(svg) {
    flex: none;
    margin-block-start: 0.2em;
    color: var(--ink-faint);
  }

  .note p {
    max-width: var(--w-prose);
    margin: 0;
    font-size: var(--step--1);
  }
</style>
