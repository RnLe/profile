---
/**
 * Reconstruction prototype: estimating 10 m terrain from 40 m area averages
 * on two held-out regions. Mean absolute error per method; "corrected" is
 * back-projection, which makes each estimate reproduce the observed averages.
 * The last two rows feed point samples instead of averages to a model trained
 * on averages (the longer-trained model, 10,000 steps; the rows above use the
 * 4,000-step one).
 */
import Bars from '../fer/Bars.astro';
import { data, regionName } from './geo';

type M = { maeM: number };
const rec = data.prototype.reconstruction;
const held = rec.task1_coarseToFine.steps4000.results.heldOut as unknown as Record<string, Record<string, M>>;
const mismatch = rec.task1_operatorMismatch_steps10000_model.results as unknown as Record<string, Record<string, Record<string, M>>>;
const regions = rec.testRegions;
const cm = (m: number) => m * 100;
const rows = [
  { label: 'bicubic', values: regions.map((r) => cm(held[r].bicubic.maeM)) },
  { label: 'bicubic, corrected', values: regions.map((r) => cm(held[r]['bicubic+bp'].maeM)) },
  { label: 'linear, corrected', values: regions.map((r) => cm(held[r]['linear+bp'].maeM)) },
  { label: 'U-Net, corrected', values: regions.map((r) => cm(held[r]['cnn+bp'].maeM)), strong: true },
  { label: 'points in: bicubic', values: regions.map((r) => cm(mismatch[r].decimate.bicubic.maeM)) },
  { label: 'points in: U-Net', values: regions.map((r) => cm(mismatch[r].decimate.cnn.maeM)) },
];
// The gain is measured against the best non-neural baseline, the fitted linear kernel with BP.
const gain = regions.map((r) => 1 - held[r]['cnn+bp'].maeM / Math.min(held[r]['linear+bp'].maeM, held[r]['bicubic+bp'].maeM));
---

<Bars
  label={`Average height error of 10 m terrain estimated from 40 m averages in ${regions.map(regionName).join(' and ')}. The corrected U-Net is ${Math.round(Math.min(...gain) * 100)} to ${Math.round(Math.max(...gain) * 100)}% better than the best simple method, a fitted linear filter, which only ties bicubic interpolation; given point samples instead of averages, the U-Net is worse than bicubic.`}
  {rows}
  parts={regions.map((r, i) => ({ label: `${regionName(r)} (held out here)`, color: i === 0 ? '#52606b' : '#a9b1b8' }))}
  stacked={false}
  x={{ label: 'average height error (cm)', max: 60 }}
  value={{ digits: 1, unit: ' cm' }}
  labelWidth={140}
  rowHeight={30}
  width={490}
  phone={{ labelWidth: 138, right: 62 }}
/>
