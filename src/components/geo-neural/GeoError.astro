---
/**
 * Bytes against mean height error: the dense conventional sweep, the quantised neural and
 * hybrid rows, the codec fits and the stored-mean control.
 */
import data from '../../data/geo-neural/candidates.json';
import Plot from '../fer/Plot.astro';
import { GEO_COLORS, kB, tip, type Candidate } from './geo';

const rows = (data.candidates as Candidate[]).filter((r) => r.package === 'finest-per-page' && r.bytes && r.maeM);
const pick = (f: (r: Candidate) => boolean) => rows.filter(f).sort((a, b) => a.bytes! - b.bytes!);
const conventional = pick((r) => r.family === 'conventional');
// The lower envelope: each point is the best mean error at its byte count or fewer.
let best = Infinity;
const front = conventional.filter((r) => (r.maeM! < best ? ((best = r.maeM!), true) : false));
const neural = pick((r) => r.family === 'neural');
const hybrid = pick((r) => r.family === 'hybrid');
const control = pick((r) => r.family === 'control');
const pts = (list: Candidate[]) => list.map((r) => [kB(r.bytes!), r.maeM!] as [number, number]);
const series = [
  { label: 'Conventional', color: GEO_COLORS.coarse, kind: 'scatter' as const, marker: 'ring' as const, size: 2.3, opacity: 0.6, points: pts(conventional), tips: conventional.map(tip) },
  { label: 'Best conventional at that size', color: GEO_COLORS.full, width: 1.8, points: pts(front) },
  { label: 'Neural', color: GEO_COLORS.neural, kind: 'scatter' as const, marker: 'cross' as const, size: 3.4, points: pts(neural), tips: neural.map(tip) },
  { label: 'Hybrid (network + coarse grid)', color: GEO_COLORS.hybrid, kind: 'scatter' as const, marker: 'square' as const, size: 3.2, points: pts(hybrid), tips: hybrid.map(tip) },
  { label: 'Stored mean', color: GEO_COLORS.control, kind: 'scatter' as const, marker: 'dot' as const, size: 3.4, points: pts(control), tips: control.map(tip) },
];
---

<Plot
  id="geo-error"
  label="Bytes against mean height error for conventional, neural and hybrid candidates"
  x={{ label: 'Bytes (kB, log scale)', log: true }}
  y={{ label: 'Mean error (m, log scale)', log: true }}
  series={series}
  width={600}
  height={340}
/>
