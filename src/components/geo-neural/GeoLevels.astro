---
/**
 * How the multilevel coder works, drawn on a sketched terrain profile: keep a
 * coarse grid, predict the points in between from their neighbors, store only
 * the difference to the true height. The profile is an illustration, not
 * data. The guesses use the coder's cubic stencil (-1, 9, 9, -1) / 16, which
 * is the midpoint of a Catmull-Rom curve through the coarse points.
 */
import { CODER_COLORS } from './geo';

const W = 240;
const H = 92;
const X0 = 14;
const X1 = W - 14;
const BASE = H - 8;
/** A sketched cross-section: two slopes and a narrow valley the coarse grid misses. */
const height = (t: number) =>
  0.56 + 0.15 * Math.sin(2 * Math.PI * 1.05 * t + 0.5) + 0.08 * Math.sin(2 * Math.PI * 3.2 * t + 1.1) + 0.06 * Math.sin(2 * Math.PI * 6.6 * t)
  - 0.2 * Math.exp(-(((t - 7 / 12) / 0.045) ** 2));
const fine = Array.from({ length: 121 }, (_, i) => i / 120);
const lo = Math.min(...fine.map(height)) - 0.12;
const hi = Math.max(...fine.map(height));
const px = (t: number) => X0 + t * (X1 - X0);
const py = (h: number) => BASE - ((h - lo) / (hi - lo)) * (BASE - 8);

const COARSE = 6;
const coarse = Array.from({ length: COARSE + 1 }, (_, i) => i / COARSE);
const mids = coarse.slice(0, -1).map((t) => t + 1 / (2 * COARSE));
const ch = coarse.map(height);
const at = (i: number) => ch[Math.min(Math.max(i, 0), COARSE)];
const guess = mids.map((_, i) => (-at(i - 1) + 9 * at(i) + 9 * at(i + 1) - at(i + 2)) / 16);

const truthPath = fine.map((t, i) => `${i ? 'L' : 'M'}${px(t).toFixed(1)},${py(height(t)).toFixed(1)}`).join('');
const groundPath = `${truthPath}L${X1},${BASE}L${X0},${BASE}Z`;
/** The guessed curve: Catmull-Rom through the coarse points. */
const guessPath = coarse
  .slice(0, -1)
  .flatMap((_, i) =>
    Array.from({ length: 12 }, (_, k) => {
      const s = k / 12;
      const [p0, p1, p2, p3] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
      const h = 0.5 * (2 * p1 + (-p0 + p2) * s + (2 * p0 - 5 * p1 + 4 * p2 - p3) * s * s + (-p0 + 3 * p1 - 3 * p2 + p3) * s ** 3);
      return [px((i + s) / COARSE), py(h)];
    }),
  )
  .concat([[px(1), py(at(COARSE))]])
  .map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`)
  .join('');

const steps = [
  { title: 'Keep a coarse grid', text: 'A few heights are stored as they are.' },
  { title: 'Predict the points in between', text: 'Each new height is guessed from its neighbors. This is where the neural predictor works.' },
  { title: 'Store only the prediction error', text: 'Only how far each guess is off goes into the file. Then halve the spacing and repeat.' },
];
const color = CODER_COLORS.learned;
---

<div class="geo-levels" style={`--guess:${color}`}>
  <ol class="steps">
    {steps.map((step, k) => (
      <li>
        <p class="head"><span class="num">{k + 1}</span>{step.title}</p>
        <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
          <path class="ground" d={groundPath} />
          <path class:list={['truth', k === 2 && 'strong']} d={truthPath} />
          {k === 0 && coarse.map((t, i) => <line class="stem" x1={px(t)} x2={px(t)} y1={py(ch[i])} y2={BASE} />)}
          {k === 1 && <path class="guess-line" d={guessPath} />}
          {k === 2 && mids.map((t, i) => <line class="residual" x1={px(t)} x2={px(t)} y1={py(guess[i])} y2={py(height(t))} />)}
          {k > 0 && mids.map((t, i) => <circle class="guess" cx={px(t)} cy={py(guess[i])} r="3.4" />)}
          {coarse.map((t, i) => <circle class="kept" cx={px(t)} cy={py(ch[i])} r="3.6" />)}
          <line class="base" x1={X0 - 6} x2={X1 + 6} y1={BASE} y2={BASE} />
        </svg>
        <p class="text">{step.text}</p>
      </li>
    ))}
  </ol>
  <ul class="legend" aria-hidden="true">
    <li><span class="sw kept-sw" />stored height</li>
    <li><span class="sw guess-sw" />guess</li>
    <li><span class="sw residual-sw" />prediction error, written to the file</li>
    <li><span class="sw truth-sw" />true terrain</li>
  </ul>
</div>

<style>
  .geo-levels {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    min-width: 0;
    max-width: 66rem;
    container: geo-levels / inline-size;
  }

  /* Each step spans three shared rows, so the drawings line up when a title wraps. */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-2) var(--sp-5);
    max-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps > li {
    position: relative;
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    align-items: start;
    min-width: 0;
  }

  /* A thin arrow from one step to the next. */
  .steps > li + li::before {
    content: '';
    position: absolute;
    top: 0.7rem;
    left: calc(-1 * var(--sp-5) + 0.35rem);
    inline-size: calc(var(--sp-5) - 0.7rem);
    border-top: 1.5px solid var(--line-strong);
  }

  .steps > li + li::after {
    content: '';
    position: absolute;
    top: calc(0.7rem - 3.5px);
    left: -0.5rem;
    border: 4px solid transparent;
    border-left: 5px solid var(--line-strong);
    border-right: 0;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    margin: 0;
    font-weight: 650;
    line-height: var(--lh-snug);
    color: var(--ink-heading);
  }

  .num {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .text {
    margin: 0;
    font-size: var(--step--1);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ground {
    fill: color-mix(in srgb, var(--ink-muted) 9%, transparent);
  }

  .truth {
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .truth.strong {
    stroke: var(--ink-muted);
  }

  .stem {
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }

  .base {
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .guess-line {
    fill: none;
    stroke: var(--guess);
    stroke-width: 1.3;
    stroke-dasharray: 4 3;
    opacity: 0.75;
  }

  .kept {
    fill: var(--ink-heading);
  }

  .guess {
    fill: var(--surface);
    stroke: var(--guess);
    stroke-width: 1.6;
  }

  .residual {
    stroke: var(--guess);
    stroke-width: 3.2;
    stroke-linecap: round;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    max-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .sw {
    display: inline-block;
    flex: none;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
  }

  .kept-sw {
    background: var(--ink-heading);
  }

  .guess-sw {
    border: 1.6px solid var(--guess);
    background: var(--surface);
  }

  .residual-sw {
    inline-size: 0.2rem;
    block-size: 0.8rem;
    border-radius: 2px;
    background: var(--guess);
  }

  .truth-sw {
    inline-size: 1.1rem;
    block-size: 0;
    border-radius: 0;
    border-top: 1.5px solid var(--ink-muted);
  }

  /* A narrow column stacks the steps, each drawing at full width. */
  @container geo-levels (max-width: 40rem) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--sp-2);
    }

    .steps > li + li {
      margin-block-start: var(--sp-3);
    }

    .steps > li + li::before,
    .steps > li + li::after {
      display: none;
    }

    svg {
      max-inline-size: 26rem;
    }
  }
</style>
