---
/**
 * One project as a larger card on the projects index: thumbnail plus an
 * optional second image, year, title, subtitle, two short paragraphs (summary
 * and contribution), any registered claims the project puts on its card, the
 * link row, and the way to the case study: its page here, or its own site.
 * A project with a showcase adds a row of buttons under its image's caption,
 * each opening one of its figures in a floating panel. A project whose own
 * website is its case study opens it in a new tab.
 * The whole card is a link to the case study (the title's link, stretched
 * over it); the links, the marker, and the slides stay clickable on top.
 * A route-gated entry renders as a dashed placeholder with no link.
 */
import type { ProjectListEntry } from '../../lib/projects';
import { withBase } from '../../lib/routes';
import { getShowcase } from '../../lib/showcases';
import { getCardThumb, getSecondaryThumb } from '../../lib/thumbs';
import Icon from '../ui/Icon.astro';
import Marked from '../ui/Marked.astro';
import ActivityMark from './ActivityMark.astro';
import ProjectLinks from './ProjectLinks.astro';
import ProjectShowcase from './ProjectShowcase.astro';
import ProjectThumb from './ProjectThumb.astro';

interface Props {
  entry: ProjectListEntry;
}

const { entry } = Astro.props;
const gated = entry.kind === 'gated';
const thumb = getCardThumb(entry.id);
const secondary = entry.kind === 'project' ? getSecondaryThumb(entry.id) : undefined;
const caption = thumb?.kind === 'image' ? thumb.caption : undefined;
const showcase = entry.kind === 'project' ? getShowcase(entry.id) : undefined;
const titleId = `${entry.id}-title`;
const caseStudyHref =
  entry.kind === 'project' ? (entry.external ? entry.href : withBase(entry.href)) : undefined;
const sizes = '(max-width: 64rem) calc(100vw - 2rem), 20rem';
---

<article
  class:list={['pcard', gated && 'pcard--gated']}
  id={entry.id}
  data-project-card={entry.id}
  data-gated={gated ? '' : undefined}
  aria-labelledby={titleId}
>
  <div class:list={['pcard-media', caption && 'pcard-media--captioned']}>
    <ProjectThumb {thumb} widths={[360, 720, 1080]} {sizes} />
    {secondary && <ProjectThumb thumb={secondary} widths={[360, 720]} {sizes} />}
    {caption && <p class="pcard-media-caption">{caption}</p>}
    {showcase && entry.kind === 'project' && (
      <div class="pcard-showcase">
        <ProjectShowcase {showcase} claimIds={entry.project.claims.map((claim) => claim.claim_id)} />
      </div>
    )}
  </div>

  <div class="pcard-body">
    <div class="pcard-meta">
      <span class="pcard-year">{entry.yearLabel}</span>
      {entry.kind === 'project' && entry.activity && (
        <span class="pcard-mark">
          <ActivityMark activity={entry.activity} />
        </span>
      )}
    </div>
    {entry.kind === 'project' && entry.label && <p class="pcard-label">{entry.label}</p>}
    <h2 class="pcard-title" id={titleId}>
      {entry.kind === 'project' ? (
        <a
          class="pcard-link"
          href={caseStudyHref}
          target={entry.external ? '_blank' : undefined}
          rel={entry.external ? 'noopener' : undefined}
        >
          {entry.title}
        </a>
      ) : (
        entry.title
      )}
    </h2>
    <p class="pcard-subtitle marked">{entry.kind === 'project' ? <Marked text={entry.subtitle} /> : entry.question}</p>

    {entry.kind === 'project' ? (
      <>
        <p class="pcard-summary marked"><Marked text={entry.summary} /></p>
        {entry.cardClaims.map((claim) => (
          <div class:list={['pcard-claim', claim.type === 'result' && 'pcard-claim--result']} data-claim-id={claim.id}>
            <p>{claim.text}</p>
            {claim.scope && <p class="pcard-claim-scope">{claim.scope}</p>}
          </div>
        ))}
        {entry.role && <p class="pcard-role">{entry.role}</p>}
        <ProjectLinks links={entry.links} />
        <p class="pcard-read">
          <a
            href={caseStudyHref}
            target={entry.external ? '_blank' : undefined}
            rel={entry.external ? 'noopener' : undefined}
          >
            {entry.external ? (
              <>
                Visit the website
                <Icon name="arrow-up-right" size={14} />
                <span class="visually-hidden"> (opens in a new tab)</span>
              </>
            ) : (
              <>
                Read the case study
                <Icon name="arrow-right" size={14} />
              </>
            )}
          </a>
        </p>
      </>
    ) : (
      <>
        <p class="pcard-summary">{entry.statusText}</p>
        <ProjectLinks links={entry.links} />
      </>
    )}
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: var(--sp-6);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    /* The images run into the card's own corners; the text side is padded. */
    overflow: hidden;
  }

  .pcard--gated {
    background: var(--surface-alt);
    border-style: dashed;
    border-color: var(--line-strong);
    box-shadow: none;
  }

  /* Runs into the card's own corners and down its full height: the text
     decides how tall the card is, the images fit themselves into what is
     left. */
  .pcard-media {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    min-height: 11rem;
  }

  /* One image takes the column; with two, the lead image sits above the figure
     and the figure keeps the larger share. */
  .pcard-media > :global(*) {
    flex: 1 1 0;
    min-height: 0;
  }

  /* Grow ratios, never a percentage: a percentage of an indefinite height
     falls back to the image's own, which would let a tall image stretch the
     card past what the text needs. */
  .pcard-media:not(.pcard-media--captioned) > :global(*:first-child:not(:last-child)) {
    flex: 46 1 0;
  }

  .pcard-media:not(.pcard-media--captioned) > :global(*:last-child:not(:first-child)) {
    flex: 54 1 0;
  }

  /* A captioned image keeps its own proportions at the top of the column,
     with its caption under it, rather than floating in the column's middle. */
  .pcard-media--captioned > :global(*) {
    flex: 0 0 auto;
  }

  .pcard-media--captioned :global(.thumb),
  .pcard-media--captioned :global(.thumb img) {
    height: auto;
  }

  .pcard-media-caption {
    max-width: none;
    padding: var(--sp-3) var(--sp-4) 0;
    font-size: var(--step--1);
    line-height: var(--lh-snug);
    color: var(--ink-faint);
  }

  .pcard-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    min-width: 0;
    padding: var(--sp-5) var(--sp-5) var(--sp-5) 0;
  }

  .pcard-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
  }

  /* At the far end of the meta row: the card's top right. */
  .pcard-mark {
    margin-inline-start: auto;
    display: inline-flex;
  }

  /* A faint, nearly square pill, as on the landing list. */
  .pcard-label {
    align-self: flex-start;
    max-width: none;
    margin-block-end: calc(-1 * var(--sp-1));
    display: inline-block;
    padding: 0.1em 0.5em;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: 1px;
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .pcard-year {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .pcard-title {
    font-size: var(--step-1);
  }

  .pcard-title a {
    color: var(--ink-heading);
    text-decoration: none;
  }

  /* The title's link covers the whole card. */
  .pcard-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* What has its own target sits above that cover. */
  .pcard-mark,
  .pcard :global([data-project-links]),
  .pcard-read,
  .pcard-showcase {
    position: relative;
    z-index: 2;
  }

  /* Hover is a pointer's feedback. A touch device that applies it keeps it
     applied after the tap, leaving the last thing touched looking active. */
  @media (hover: hover) {
    .pcard {
      transition:
        border-color var(--dur-fast) var(--ease-out),
        box-shadow var(--dur-fast) var(--ease-out);
    }

    .pcard:has(.pcard-link:hover) {
      border-color: var(--line-strong);
      box-shadow: 0 2px 4px rgb(24 33 41 / 0.05), 0 10px 26px rgb(24 33 41 / 0.08);
    }

    .pcard-link:hover {
      color: var(--accent-strong);
    }
  }

  .pcard--gated .pcard-title {
    color: var(--ink-muted);
  }

  .pcard-subtitle {
    max-width: none;
    margin-block-start: calc(-1 * var(--sp-1));
    font-size: var(--step-0);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .pcard-summary,
  .pcard-role {
    max-width: none;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .pcard-role {
    color: var(--ink-faint);
  }

  /* A registered claim, word for word from the claim registry. A result
     leads, with a rule of the accent beside it and its registered scope
     under it; a limitation stays quiet. */
  .pcard-claim p {
    max-width: none;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .pcard-claim--result {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding-inline-start: var(--sp-3);
    border-inline-start: 3px solid var(--accent);
  }

  .pcard-claim--result > p:first-child {
    font-size: var(--step-0);
    font-weight: 560;
    line-height: var(--lh-snug);
    color: var(--ink-heading);
  }

  /* Under the image's caption, in the image column. */
  .pcard-showcase {
    min-width: 0;
    padding: var(--sp-4) var(--sp-4) var(--sp-5);
  }

  .pcard-read {
    margin-block-start: auto;
  }

  .pcard-read a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 600;
    font-size: var(--step--1);
    text-decoration: none;
  }

  @media (hover: hover) {
    .pcard-read a:hover {
      text-decoration: underline;
    }
  }

  /* A finger needs the 44 px guideline; a mouse keeps the page's density. */
  @media (pointer: coarse) {
    .pcard-read a {
      min-height: 1.75rem;
    }
  }

  @media (max-width: 63.99rem) {
    .pcard {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }

    .pcard-body {
      padding: 0 var(--sp-5) var(--sp-5);
    }

    /*
     * Stacked: nothing beside it to take its height from, so the images keep
     * the proportions they have next to the text on a desktop (a 20 rem column
     * about as tall as it is wide). Each shows the same part of its picture,
     * rather than a wide band across it. A captioned image keeps its own.
     */
    .pcard-media {
      aspect-ratio: 20 / 21;
    }

    .pcard-media--captioned {
      aspect-ratio: auto;
    }

    /* In line with the text below it. */
    .pcard-media-caption {
      padding-inline: var(--sp-5);
    }

    .pcard-showcase {
      padding-inline: var(--sp-5);
    }
  }

</style>
