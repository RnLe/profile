---
/**
 * One project as a compact, full-width stripe: thumbnail, year, title,
 * subtitle, status, and the CV-style link row. The title is the only anchor
 * and is stretched over the stripe with a pseudo-element, so the whole stripe
 * is clickable, the link's name stays the title, and the link row keeps its
 * own anchors above the stretched one. A route-gated entry renders as a
 * dashed placeholder: no case-study link, only whatever public targets its
 * sanctioned record carries.
 */
import type { ProjectListEntry } from '../../lib/projects';
import { withBase } from '../../lib/routes';
import StatusChip from '../ui/StatusChip.astro';
import ProjectLinks from './ProjectLinks.astro';
import ProjectThumb from './ProjectThumb.astro';

interface Props {
  entry: ProjectListEntry;
}

const { entry } = Astro.props;
const gated = entry.kind === 'gated';
---

<li
  class:list={['stripe', gated && 'stripe--gated']}
  data-project-id={entry.id}
  data-gated={gated ? '' : undefined}
  style={`--tone: var(--status-${entry.status.tone});`}
>
  <div class="stripe-thumb">
    <ProjectThumb
      id={entry.id}
      widths={[176, 352, 528]}
      sizes="(max-width: 40rem) 5.5rem, (max-width: 64rem) 9rem, 10.5rem"
      ratio="16 / 9"
    />
  </div>
  <span class="stripe-year">{entry.yearLabel}</span>
  <div class="stripe-text">
    <h3 class="stripe-title">
      {entry.kind === 'project' ? (
        <a href={withBase(entry.href)} data-project-link>{entry.title}</a>
      ) : (
        entry.title
      )}
    </h3>
    <p class="stripe-subtitle">{entry.kind === 'project' ? entry.subtitle : entry.statusText}</p>
  </div>
  <div class="stripe-status">
    <StatusChip model={entry.status} />
  </div>
  {entry.links.length > 0 && (
    <div class="stripe-links">
      <ProjectLinks links={entry.links} />
    </div>
  )}
</li>

<style>
  .stripe {
    position: relative;
    display: grid;
    grid-template-columns: 10.5rem 7rem minmax(0, 1fr) auto;
    grid-template-areas:
      'thumb year text status'
      'thumb year links status';
    align-items: start;
    column-gap: var(--sp-4);
    row-gap: var(--sp-2);
    /* The thumbnail runs to the edge, so only the text side is padded. */
    padding: var(--sp-3) var(--sp-4) var(--sp-3) 0;
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--tone);
    border-radius: var(--r-md);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .stripe:hover {
    border-color: var(--line-strong);
    border-inline-start-color: var(--tone);
    background: var(--surface-alt);
  }

  /* The stretched anchor has no box of its own to ring; the stripe shows the ring. */
  .stripe:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Flush with the stripe's own corner: no frame of its own, no inset. */
  .stripe-thumb {
    grid-area: thumb;
    align-self: stretch;
    margin: calc(-1 * var(--sp-3)) 0;
    min-height: 4.25rem;
  }

  .stripe-year {
    grid-area: year;
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .stripe-text {
    grid-area: text;
    min-width: 0;
  }

  .stripe-title {
    font-size: var(--step-0);
    font-weight: 640;
    line-height: var(--lh-tight);
    letter-spacing: -0.008em;
    color: var(--ink-heading);
  }

  .stripe-title a {
    color: inherit;
    text-decoration: none;
  }

  .stripe-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .stripe-title a:focus-visible {
    outline: none;
  }

  .stripe:hover .stripe-title a {
    color: var(--accent-strong);
  }

  .stripe-subtitle {
    margin-block-start: 0.2em;
    max-width: none;
    font-size: var(--step--1);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .stripe-status {
    grid-area: status;
    justify-self: end;
  }

  /* Above the stretched anchor, so its own links stay clickable. */
  .stripe-links {
    grid-area: links;
    position: relative;
    z-index: 1;
  }

  .stripe--gated {
    background: var(--surface-alt);
    border-style: dashed;
    border-color: var(--line-strong);
    border-inline-start-style: solid;
  }

  .stripe--gated:hover {
    background: var(--surface-alt);
  }

  .stripe--gated .stripe-title {
    color: var(--ink-muted);
  }

  @media (max-width: 63.99rem) {
    .stripe {
      grid-template-columns: 9rem minmax(0, 1fr) auto;
      grid-template-areas:
        'thumb year status'
        'thumb text text'
        'thumb links links';
    }
  }

  @media (max-width: 40rem) {
    .stripe {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      grid-template-areas:
        'thumb text'
        'year status'
        'links links';
    }

    /* Two rows tall here, so it bleeds only at the top. */
    .stripe-thumb {
      margin-block-end: 0;
    }

    .stripe-year {
      padding-inline-start: var(--sp-3);
    }

    .stripe-links {
      padding-inline-start: var(--sp-3);
    }

    .stripe-status {
      justify-self: start;
    }
  }
</style>
