---
/**
 * The key to the projects rail's marks, in one row under the page title: the
 * three kinds of work, each with its mark in its colour.
 */
import { KINDS, kindColours } from '../../lib/kinds';
import Icon from '../ui/Icon.astro';
---

<ul class="legend">
  {KINDS.map((item) => (
    <li style={kindColours(item.kind)}>
      <Icon name={item.icon} size={15} />
      <span>{item.label}</span>
    </li>
  ))}
</ul>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
    max-width: none;
    margin: calc(-1 * var(--sp-2)) 0 var(--sp-6);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .legend :global(svg) {
    color: var(--kind);
  }
</style>
