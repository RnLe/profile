---
/**
 * The band comparison of the Blaze2D pitch page (web/app/pitch), in this
 * site's light palette and on one set of axes: MPB draws its TM and then its
 * TE bands, and Blaze (mixed precision) follows a moment later on top of
 * them as dark dots of the same two hues, spaced so both read at once. Each is an independent calculation. Data: the Blaze2D
 * website's benchmarks/series6-accuracy.json, copied into
 * src/data/blaze-benchmarks.json.
 *
 * The finished plot is the markup's own state; with motion allowed, the
 * script arms the figure and plays the sequence whenever it comes into view.
 */
import benchmarks from '../../data/blaze-benchmarks.json';

type Point = [number, number[]];
type Polarization = 'TM' | 'TE';
type Solver = 'mpb' | 'blaze_f32';
const { accuracy } = benchmarks;
const polarizations: { key: Polarization; offset: number }[] = [
  { key: 'TM', offset: 0 },
  { key: 'TE', offset: 900 },
];
const solvers: { key: Solver; label: string; dotted: boolean; start: number }[] = [
  { key: 'mpb', label: 'MPB', dotted: false, start: 200 },
  { key: 'blaze_f32', label: 'Blaze', dotted: true, start: 2600 },
];

const W = 560;
const H = 380;
const left = 44;
const right = W - 8;
const top = 30;
const bottom = H - 34;

const points = (pol: Polarization, solver: Solver) => accuracy[pol][solver] as Point[];
const maxX = points('TM', 'mpb').at(-1)![0];
const maxY =
  Math.ceil(
    Math.max(...polarizations.flatMap((p) => solvers.flatMap((s) => points(p.key, s.key).flatMap(([, f]) => f)))) * 2,
  ) / 2;
const x = (k: number) => left + (k / maxX) * (right - left);
const y = (f: number) => bottom - (f / maxY) * (bottom - top);
const yTicks = Array.from({ length: Math.round(maxY / 0.5) + 1 }, (_, i) => i * 0.5);
const per = accuracy.parameters.k_points_per_segment;
const xTicks = ['Γ', 'X', 'M', 'Γ'].map((label, i) => ({ label, at: x(points('TM', 'mpb')[i * per][0]) }));
const bands = (pol: Polarization, solver: Solver) =>
  Array.from({ length: accuracy.parameters.num_bands }, (_, band) =>
    points(pol, solver)
      .map(([k, f]) => `${x(k).toFixed(2)},${y(f[band]).toFixed(2)}`)
      .join(' '),
  );
---

<div class="accuracy" data-animate>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="Band structures from MPB (solid) and from Blaze in mixed precision (dotted) on one set of axes, each computed independently for a square lattice of rods, TM in blue and TE in orange; the dotted Blaze bands lie on the MPB bands."
  >
    <defs>
      {solvers.map((solver) =>
        polarizations.map((p) => (
          <clipPath id={`blaze-accuracy-${solver.key}-${p.key}`}>
            <rect
              class="reveal"
              style={`--start: ${solver.start + p.offset}ms;`}
              x={left}
              y={top - 2}
              width={right - left}
              height={bottom - top + 4}
            />
          </clipPath>
        )),
      )}
    </defs>
    <g class="axes">
      {yTicks.map((value) => (
        <g>
          <line x1={left} x2={right} y1={y(value)} y2={y(value)} />
          <text x={left - 7} y={y(value) + 4} text-anchor="end">{value.toFixed(1)}</text>
        </g>
      ))}
      {xTicks.map((tick) => (
        <g>
          <line x1={tick.at} x2={tick.at} y1={top} y2={bottom} />
          <text x={tick.at} y={bottom + 20} text-anchor="middle">{tick.label}</text>
        </g>
      ))}
      <text x={left - 30} y={top - 12}>Frequency (c/a)</text>
    </g>
    {solvers.map((solver) =>
      polarizations.map((p) => (
        <g
          class:list={['bands', `pol-${p.key}`, solver.dotted && 'dotted']}
          clip-path={`url(#blaze-accuracy-${solver.key}-${p.key})`}
        >
          {bands(p.key, solver.key).map((line) => (
            <polyline points={line} />
          ))}
        </g>
      )),
    )}
  </svg>
  <p class="legend">
    {solvers.map((solver) =>
      polarizations.map((p) => (
        <span class:list={[`pol-${p.key}`, solver.dotted && 'dotted']}>
          <svg width="28" height="8" viewBox="0 0 28 8" aria-hidden="true">
            <line x1="1" y1="4" x2="27" y2="4" />
          </svg>
          {p.key} {solver.label}
        </span>
      )),
    )}
  </p>
</div>

<script>
  import '../../lib/play-on-view';
</script>

<style>
  .accuracy {
    --tm: #5b9bd5;
    --tm-dots: #0f2f57;
    --te: #f08a3c;
    --te-dots: #6e2600;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    overflow: visible;
  }

  .axes line {
    stroke: var(--line);
  }

  .axes text {
    font-size: 12px;
    fill: var(--ink-muted);
  }

  .pol-TM {
    --tone: var(--tm);
    --tone-dots: var(--tm-dots);
  }

  .pol-TE {
    --tone: var(--te);
    --tone-dots: var(--te-dots);
  }

  .bands {
    fill: none;
    stroke: var(--tone);
    stroke-width: 3.2;
  }

  /* Round dots with room between them, so the MPB line shows through. */
  .bands.dotted {
    stroke: var(--tone-dots);
    stroke-width: 2.2;
    stroke-dasharray: 0.1 6.5;
    stroke-linecap: round;
  }

  .reveal {
    transform-box: fill-box;
    transform-origin: 0 50%;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-1) var(--sp-4);
    max-width: none;
    margin-block-start: var(--sp-2);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .legend svg {
    inline-size: 1.75rem;
  }

  .legend line {
    stroke: var(--tone);
    stroke-width: 2.6;
  }

  .legend .dotted line {
    stroke: var(--tone-dots);
    stroke-dasharray: 0.1 6.5;
    stroke-linecap: round;
  }

  /* Armed by the script: the bands draw in, MPB first, then Blaze on top. */
  :global(.armed) .reveal {
    transform: scaleX(0);
  }

  :global(.armed.play) .reveal {
    animation: draw 1150ms cubic-bezier(0.4, 0, 0.2, 1) var(--start) both;
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }
</style>
