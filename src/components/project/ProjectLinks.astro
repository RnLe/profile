---
/**
 * The link row of a project, in the CV's vocabulary: one marker glyph per
 * link, and a document's length and size in the same underlined run as its
 * label. Shares the .link-row primitive with the CV artifact row, so the two
 * read as one and cannot drift apart.
 */
import type { ProjectLinkItem } from '../../lib/projects';
import { withBase } from '../../lib/routes';
import Icon from '../ui/Icon.astro';

interface Props {
  links: ProjectLinkItem[];
}

const { links } = Astro.props;
---

{links.length > 0 && (
  <p class="artifacts link-row" data-project-links>
    {links.map((link) => (
      <span>
        <a
          href={link.external ? link.href : withBase(link.href)}
          target={link.newTab ? '_blank' : undefined}
          rel="noopener"
          class:list={[link.emphasis && 'is-primary', link.mark && 'has-mark']}
        >
          {link.mark ? (
            <img class="mark" src={withBase(link.mark)} alt="" />
          ) : (
            <Icon name={link.icon} size={14} />
          )}
          <span class="text">{link.label}{link.meta && <span class="size">&nbsp;({link.meta})</span>}</span>
        </a>
      </span>
    ))}
  </p>
)}

<style>
  /* Geometry, spacing and touch sizing come from .link-row in global.css. */
  .artifacts {
    margin: 0;
  }

  /*
   * Label and size are one inline run inside the link, not two flex items:
   * flex items are blockified, so each would carry its own underline and the
   * flex gap between them would sit undecorated. A single run underlines
   * continuously, and the space between them is a plain non-breaking space.
   */
  .text {
    text-decoration: inherit;
  }

  .size {
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  /* A thesis is the document a reader of the row looks for first. */
  .is-primary {
    font-weight: 640;
  }

  /* A project's own mark leads the row as its name, as on the CV. The flame
     sits low in its artboard, so it is nudged up optically. */
  .has-mark {
    font-weight: 640;
  }

  .mark {
    display: block;
    height: 1.5em;
    width: auto;
    transform: translateY(-0.2em);
  }

</style>
