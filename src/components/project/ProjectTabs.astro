---
/**
 * A case study told in parts, for a study with several. Each part opens with
 * its number and name, then its core questions set large (Question), its
 * lead figure, a few short paragraphs, its steps, a note of the work still to
 * come (Continued) where there is some, its references, and a way on to the
 * neighbouring parts. The first part is the overview: it also
 * carries the Markdown body, the project's own sections and citations, and
 * the novelty scope. The rail (CaseRail) lists the parts beside the article.
 *
 * Without JavaScript every part shows, one after another, and the rail and
 * the pager are anchors into them. lib/tabs shows one part at a time,
 * delegated from the document so the same markup works on the page and in
 * the landing page's overlay.
 */
import CaseRail from './CaseRail.astro';
import FigureRenderer from './FigureRenderer.astro';
import ProjectSteps from './ProjectSteps.astro';
import Continued from '../ui/Continued.astro';
import Marked from '../ui/Marked.astro';
import Question from '../ui/Question.astro';
import { panelId, partNumber, stepIds, type RailPart } from '../../lib/case-nav';
import type { ResolvedProject } from '../../lib/publication';

interface Props {
  project: ResolvedProject;
}

const { project } = Astro.props;
const { data } = project;
const uid = data.slug;
const count = data.tabs.length - 1;
const tabs = data.tabs.map((tab, i) => {
  const steps = i === 0 ? [...data.sections, ...tab.sections] : tab.sections;
  const prefix = tab.id;
  return {
    ...tab,
    overview: i === 0,
    num: partNumber(i),
    panel: panelId(uid, tab.id),
    steps,
    prefix,
    stepIds: stepIds(prefix, steps.map((step) => step.heading)),
    citations: i === 0 ? [...data.citations, ...tab.citations] : tab.citations,
  };
});
const parts: RailPart[] = tabs.map((tab) => ({
  id: tab.panel,
  part: tab.id,
  label: tab.label,
  num: tab.num,
  steps: tab.steps.map((step, i) => ({ id: tab.stepIds[i], label: step.heading })),
}));
const partTitle = (tab: (typeof tabs)[number]) => (tab.num ? `${tab.num} ${tab.label}` : tab.label);
---

<div class="band band--tight case-tabs">
  <div class="wrap">
    <div class="case-layout" data-case="parts" data-tabs>
      <CaseRail title={data.shortTitle ?? data.title} {parts} />

      <div class="case-main">
        {tabs.map((tab, i) => {
          const prev = tabs[i - 1];
          const next = tabs[i + 1];
          return (
            <section class="panel" id={tab.panel} aria-labelledby={`${tab.panel}-title`} data-panel={tab.id}>
              <h2 class="panel-title" id={`${tab.panel}-title`}>
                {tab.overview ? (
                  <span class="panel-num">{tab.label}</span>
                ) : (
                  <>
                    <span class="panel-num">Part {tab.num} of {String(count).padStart(2, '0')}</span>
                    <span class="panel-name">{tab.label}</span>
                  </>
                )}
              </h2>

              <Question text={tab.questions} />

              {tab.figureId && (
                <div class="lead-figure">
                  <FigureRenderer figureId={tab.figureId} />
                </div>
              )}

              {(tab.paragraphs.length > 0 || tab.overview) && (
                <div class="lead-text prose marked">
                  {tab.paragraphs.map((paragraph) => (
                    <p><Marked text={paragraph} /></p>
                  ))}
                  {tab.overview && <slot />}
                </div>
              )}

              <ProjectSteps steps={tab.steps} claims={project.claims} idPrefix={tab.prefix} />

              {tab.continued && (
                <div class="panel-continued">
                  <Continued text={tab.continued} />
                </div>
              )}

              {tab.citations.length > 0 && (
                <div class="refs">
                  <h3>References</h3>
                  <ol class="citations">
                    {tab.citations.map((citation) => (
                      <li>
                        {citation.href ? <a href={citation.href} rel="noopener">{citation.label}</a> : citation.label}
                        {citation.note && <span class="cite-note"> · {citation.note}</span>}
                      </li>
                    ))}
                  </ol>
                  {tab.overview && <p class="novelty"><strong>Novelty scope:</strong> {data.noveltyNote}</p>}
                </div>
              )}

              {(prev || next) && (
              <div class="pager">
                {prev && (
                  <a class="pager-link pager-prev" href={`#${prev.panel}`}>
                    <span class="pager-dir">Previous part</span>
                    <span class="pager-title">{partTitle(prev)}</span>
                  </a>
                )}
                {next && (
                  <a class="pager-link pager-next" href={`#${next.panel}`}>
                    <span class="pager-dir">Next part</span>
                    <span class="pager-title">{partTitle(next)}</span>
                  </a>
                )}
              </div>
              )}
            </section>
          );
        })}
      </div>
    </div>
  </div>
</div>

<style>
  .case-tabs {
    border-bottom: none;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  /* Stacked parts (no script) are told apart by their headings. */
  .panel + .panel {
    margin-block-start: var(--sp-16);
  }

  :global(.has-js) .panel + .panel {
    margin-block-start: 0;
  }

  /* Only the script hides a part, so [hidden] needs no .has-js. Before it
     runs, the first part stands in for the open one. */
  .panel[hidden],
  :global(.has-js) [data-tabs]:not(.tabs--ready) .panel:not(:first-of-type) {
    display: none;
  }

  /* The part's number and name, small: its question is the headline. */
  .panel-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-3);
    margin-block-end: calc(var(--sp-2) * -1);
    font-size: var(--step-0);
    font-weight: 640;
    line-height: var(--lh-snug);
    color: var(--ink-heading);
  }

  .panel-title:focus {
    outline: none;
  }

  .panel-title:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: var(--r-sm);
  }

  .panel-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 560;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .lead-figure {
    min-width: 0;
  }

  .lead-text {
    max-width: var(--w-prose);
  }

  .lead-text :global(p) {
    margin: 0;
  }

  .lead-text :global(p + p) {
    margin-block-start: var(--sp-3);
  }

  .panel :global(.steps) {
    margin-block-start: var(--sp-6);
  }

  .panel-continued {
    margin-block-start: var(--sp-10);
  }

  .refs {
    margin-block-start: var(--sp-8);
    padding-block-start: var(--sp-5);
    border-top: 1px solid var(--line);
  }

  .refs h3 {
    margin-block-end: var(--sp-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .citations {
    max-width: var(--w-prose);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .cite-note {
    color: var(--ink-faint);
  }

  .novelty {
    margin-block-start: var(--sp-5);
    max-width: var(--w-prose);
    font-size: var(--step--1);
    color: var(--ink-muted);
    border-inline-start: 3px solid var(--line-strong);
    padding-inline-start: var(--sp-4);
  }

  /* On to the neighboring parts, at the end of each: the reader never has
     to scroll back up to the rail to keep going. Each card fills its share of
     the row, so wrapped cards reach the column's edge. */
  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-block-start: var(--sp-8);
  }

  .pager-link {
    flex: 1 1 16rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink-heading);
  }

  .pager-next {
    align-items: flex-end;
    text-align: end;
  }

  .pager-next:only-child {
    margin-inline-start: auto;
  }

  .pager-dir {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .pager-prev .pager-dir::before {
    content: '← ';
  }

  .pager-next .pager-dir::after {
    content: ' →';
  }

  .pager-title {
    font-size: var(--step-0);
    font-weight: 600;
  }

  @media (hover: hover) {
    .pager-link:hover {
      border-color: var(--accent);
      color: var(--accent-strong);
    }
  }

  .pager-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media print {
    .pager {
      display: none;
    }
  }
</style>
