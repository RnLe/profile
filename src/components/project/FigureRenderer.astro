---
/**
 * Renders a registry figure: owned image, trusted local SVG pair,
 * interactive island (with server-rendered deterministic first frame as the
 * no-JS fallback), or an asset placeholder. Every figure carries a visible
 * title and caption.
 */
import { Image } from 'astro:assets';
import { getFigure } from '../../lib/figures';
import AssetPlaceholder from '../ui/AssetPlaceholder.astro';
import DrawFigure from '../ui/DrawFigure.astro';
import MoireExplorer from '../islands/MoireExplorer';
import TwoLinkPreview from '../islands/TwoLinkPreview';

interface Props {
  figureId: string;
}

const { figureId } = Astro.props;
const figure = getFigure(figureId);
---

{figure.kind === 'placeholder' && (
  <AssetPlaceholder
    assetId={figure.assetId}
    spec={figure.spec}
    ratio={figure.ratio}
    caption={figure.caption}
  />
)}

{figure.kind === 'image' && (
  <figure class:list={['figure', figure.layout === 'aside' && 'figure--aside']}>
    {figure.animated ? (
      /* Served untouched: the image service would flatten it to one frame. */
      <img
        src={figure.src.src}
        width={figure.src.width}
        height={figure.src.height}
        alt={figure.alt}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image
        src={figure.src}
        alt={figure.alt}
        widths={figure.widths ?? [800, 1200]}
        sizes={figure.layout === 'aside' ? '(max-width: 48rem) 100vw, 18rem' : '(max-width: 48rem) 100vw, 46rem'}
      />
    )}
    <figcaption>
      <strong>{figure.title}.</strong>
      {figure.caption}
    </figcaption>
  </figure>
)}

{figure.kind === 'gallery' && (
  <figure class="figure">
    <div class="gallery">
      {figure.items.map((item) => (
        <div class="shot">
          <Image
            src={item.src}
            alt={item.alt}
            widths={[400, 800]}
            sizes="(max-width: 48rem) 100vw, 22rem"
          />
          <p class="shot-caption">{item.caption}</p>
        </div>
      ))}
    </div>
    <figcaption>
      <strong>{figure.title}.</strong>
      {figure.caption}
    </figcaption>
  </figure>
)}

{figure.kind === 'svg-pair' && (
  <figure class="figure">
    <div class="pair">
      {figure.items.map((item, index) => (
        <div>
          <DrawFigure svg={item.raw} name={`${figureId}-${index}`} label={item.label} />
          <p class="pair-caption">{item.caption}</p>
        </div>
      ))}
    </div>
    <figcaption>
      <strong>{figure.title}.</strong>
      {figure.caption}
    </figcaption>
  </figure>
)}

{figure.kind === 'island' && (
  <figure class="figure figure--island">
    {figure.previewLabel && <p class="preview-label">{figure.previewLabel}</p>}
    <div class="island-frame">
      {figure.island === 'moire-explorer' && <MoireExplorer client:visible />}
      {figure.island === 'two-link-preview' && <TwoLinkPreview client:visible />}
      <noscript>
        <p class="noscript-note">{figure.fallbackText}</p>
      </noscript>
    </div>
    <figcaption>
      <strong>{figure.title}.</strong>
      {figure.caption}
    </figcaption>
  </figure>
)}

<style>
  .figure {
    margin: 0;
  }

  .figure :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  figcaption {
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-block-start: var(--sp-3);
    max-width: var(--w-prose);
  }

  figcaption strong {
    color: var(--ink);
    margin-inline-end: 0.35em;
  }

  /* A small image with its caption beside it, both vertically centred. */
  .figure--aside {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    /* Caption and image stay near each other even on the wide stage. */
    max-width: 48rem;
  }

  .figure--aside :global(img) {
    order: 2;
    flex: none;
    width: 18rem;
    max-width: 45%;
  }

  .figure--aside figcaption {
    order: 1;
    flex: 1 1 auto;
    margin-block-start: 0;
  }

  @container (max-width: 40rem) {
    .figure--aside {
      display: block;
    }

    .figure--aside :global(img) {
      width: 100%;
      max-width: none;
    }

    .figure--aside figcaption {
      margin-block-start: var(--sp-3);
    }
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--sp-6);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--sp-4);
  }

  .gallery :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .shot-caption {
    font-size: var(--step--2);
    color: var(--ink-faint);
    margin-block-start: var(--sp-2);
  }

  .pair-caption {
    font-size: var(--step--2);
    color: var(--ink-faint);
    margin-block-start: var(--sp-2);
  }

  .preview-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 620;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--status-active);
    background: var(--status-active-bg);
    border: 1px solid color-mix(in srgb, var(--status-active) 30%, transparent);
    border-radius: 999px;
    padding: 0.3em 0.8em;
    margin-block-end: var(--sp-3);
  }

  .island-frame {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    padding: var(--sp-4);
    overflow: hidden;
  }

  .noscript-note {
    font-size: var(--step--1);
    color: var(--ink-muted);
    padding: var(--sp-2);
  }
</style>

{/* Island-internal styles live here (global, class-scoped) so the SSR'd JSX
    stays free of <style> elements. */}
<style is:global>
  .moire-explorer .controls,
  .two-link .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-6);
    padding-block-start: var(--sp-4);
  }

  .moire-explorer label {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    min-width: 14rem;
    flex: 1;
  }

  .moire-explorer .control-label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-muted);
  }

  .moire-explorer input[type='range'] {
    accent-color: var(--accent);
    min-height: 1.5rem;
  }

  .moire-explorer .readout,
  .two-link .readout {
    flex-basis: 100%;
    font-size: var(--step--2);
    color: var(--ink-faint);
    margin: 0;
  }

  .moire-explorer button,
  .two-link button {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.4rem var(--sp-4);
    min-height: 2.75rem;
    border-radius: var(--r-md);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .moire-explorer button:hover,
  .two-link button:hover:not(:disabled) {
    background: var(--surface-alt);
  }

  .two-link button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .two-link button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .two-link .controls {
    justify-content: space-between;
  }

  .two-link fieldset {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--sp-2) var(--sp-4) var(--sp-3);
    display: flex;
    gap: var(--sp-5);
    margin: 0;
  }

  .two-link legend {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-faint);
    padding-inline: var(--sp-1);
  }

  .two-link fieldset label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    min-height: 1.75rem;
  }

  .two-link input[type='checkbox'] {
    accent-color: var(--accent);
    width: 1.05rem;
    height: 1.05rem;
  }

  .two-link .buttons {
    display: flex;
    gap: var(--sp-2);
  }
</style>
