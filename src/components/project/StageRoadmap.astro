---
/**
 * The first three stages of the Blaze2D roadmap as the Blaze website draws
 * them (three cards, each module with its status), in this site's light
 * palette. Every stage and module opens its section of the roadmap page in a
 * new tab.
 */
import { blazeRoadmap, roadmapUrl, type RoadmapStatus } from '../../data/blaze-roadmap';
import Icon from '../ui/Icon.astro';

const statusClass: Record<RoadmapStatus, string> = {
  Done: 'is-done',
  'In Development': 'is-developing',
  Planned: 'is-planned',
};
---

<ol class="roadmap">
  {blazeRoadmap.map((stage) => (
    <li class="stage" data-stage={stage.number}>
      <a class="stage-head" href={`${roadmapUrl}#${stage.anchor}`} target="_blank" rel="noopener noreferrer">
        <span class="stage-label">
          Stage {stage.number}
          <Icon name="arrow-up-right" size={14} />
        </span>
        <h3>{stage.title}</h3>
        <span class="stage-description">{stage.description}</span>
      </a>
      <ul class="modules">
        {stage.modules.map((module) => (
          <li>
            <a class="module" href={`${roadmapUrl}#${module.anchor}`} target="_blank" rel="noopener noreferrer">
              <span class="module-heading">
                <span class="module-title">{module.title}</span>
                <span class:list={['status', statusClass[module.status]]}>{module.status}</span>
              </span>
              <span class="module-description">{module.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<style>
  /* Two shared rows, so the stage introductions and the module lists line up
     across the three cards. */
  .roadmap {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: 0 var(--sp-4);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }

  .stage {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-top: 2px solid var(--stage-color);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .stage[data-stage='1'] {
    --stage-color: #317cb8;
  }

  .stage[data-stage='2'] {
    --stage-color: #6f8fe0;
  }

  .stage[data-stage='3'] {
    --stage-color: #eb7929;
  }

  .stage-head {
    display: block;
    padding: var(--sp-4) var(--sp-4) var(--sp-5);
    color: inherit;
    text-decoration: none;
  }

  .stage-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: var(--sp-2);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-faint);
  }

  .stage h3 {
    font-size: var(--step-1);
    line-height: var(--lh-snug);
  }

  .stage-description {
    display: block;
    margin-block-start: var(--sp-2);
    font-size: var(--step--1);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .modules {
    display: grid;
    grid-auto-rows: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }

  .module {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    height: 100%;
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .module-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
  }

  .module-title {
    flex: 1 1 7rem;
    font-size: var(--step-0);
    font-weight: 600;
    line-height: var(--lh-snug);
    color: var(--ink-heading);
  }

  .module-description {
    font-size: var(--step--1);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .status {
    flex-shrink: 0;
    margin-inline-start: auto;
    padding: 0.05rem 0.55rem;
    border: 1px solid color-mix(in srgb, currentColor 35%, var(--line));
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.6;
    white-space: nowrap;
  }

  .status.is-done {
    color: #1a7a43;
  }

  .status.is-developing {
    color: #2a6ea6;
  }

  .status.is-planned {
    color: #a8520b;
  }

  @media (hover: hover) {
    .stage-head:hover,
    .module:hover {
      background: var(--surface-alt);
    }
  }

  .stage a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -3px;
  }

  /* Narrow: the stages stack, one card after another. */
  @container (max-width: 48rem) {
    .roadmap {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: var(--sp-4);
    }

    .stage {
      grid-template-rows: none;
      grid-row: auto;
    }
  }
</style>
