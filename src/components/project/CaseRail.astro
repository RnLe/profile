---
/**
 * A case study's own navigation, beside it on the left. For a study told in
 * parts it lists the parts (the open one marked, its steps under it, the
 * step in view marked as the reader scrolls); for a single page it lists the
 * page's sections. Every row is a plain anchor, so without JavaScript the
 * rail is a table of contents for the stacked parts; lib/tabs does the rest.
 *
 * Beside the article it floats and sticks while the page scrolls. When the
 * article is too narrow to spare it a column (ProjectArticle sets where), the
 * parts become a compact list at the top of the case study that scrolls away
 * with it, and a single page's rail is left out (the pager at the end of each
 * part takes over).
 */
import type { RailLink, RailPart } from '../../lib/case-nav';

interface Props {
  title: string;
  /** The parts of a study told in parts. */
  parts?: RailPart[];
  /** Or, for a single page, its sections in order. */
  links?: RailLink[];
}

const { title, parts, links = [] } = Astro.props;
---

<nav
  class:list={['case-rail', parts ? 'case-rail--parts' : 'case-rail--page']}
  aria-label={parts ? `Parts of the ${title} case study` : `Sections of the ${title} case study`}
>
  <div class="rail-card">
    <p class="rail-head">
      <span class="rail-label">{parts ? 'Contents' : 'On this page'}</span>
      <span class="rail-title">{title}</span>
    </p>
    {parts ? (
      <ol class="rail-parts">
        {parts.map((part) => (
          <li>
            <a class="rail-part" href={`#${part.id}`} data-part-link={part.part}>
              <span class="rail-num" aria-hidden="true">{part.num || '·'}</span>
              <span class="rail-name">{part.label}</span>
            </a>
            {part.steps.length > 0 && (
              <ol class="rail-steps">
                {part.steps.map((step) => (
                  <li><a href={`#${step.id}`} data-spy>{step.label}</a></li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    ) : (
      <ol class="rail-steps rail-steps--page">
        {links.map((link) => (
          <li><a href={`#${link.id}`} data-spy>{link.label}</a></li>
        ))}
      </ol>
    )}
  </div>
</nav>

<script>
  import '../../lib/tabs';
</script>

<style>
  /* ------------------------------------------------- narrow: a part list --- */
  .case-rail--page {
    display: none;
  }

  .case-rail--parts {
    margin-block-end: var(--sp-8);
  }

  .rail-card {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    overflow: hidden;
  }

  .rail-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: none;
    margin: 0;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--line);
    background: var(--accent-wash);
    color: var(--accent-strong);
  }

  .rail-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 560;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .rail-title {
    font-size: var(--step--1);
    font-weight: 640;
    line-height: var(--lh-snug);
  }

  .rail-parts,
  .rail-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }

  .rail-parts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 2px var(--sp-2);
    padding: var(--sp-2);
  }

  .rail-part {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--sp-1);
    min-height: 2.5rem;
    align-content: center;
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-sm);
    font-size: var(--step--1);
    line-height: var(--lh-snug);
    color: var(--ink);
    text-decoration: none;
  }

  .rail-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-faint);
  }

  .rail-name {
    overflow-wrap: anywhere;
  }

  .rail-part[aria-current='true'] {
    background: var(--accent-wash);
    box-shadow: inset 3px 0 var(--accent);
    color: var(--accent-strong);
    font-weight: 640;
  }

  .rail-part[aria-current='true'] .rail-num {
    color: var(--accent);
  }

  @media (hover: hover) {
    .rail-part:hover,
    .rail-steps a:hover {
      background: var(--surface-alt);
      color: var(--ink);
    }

    .rail-part[aria-current='true']:hover {
      background: var(--accent-wash);
      color: var(--accent-strong);
    }
  }

  .rail-part:focus-visible,
  .rail-steps a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* A part's steps show beside the article, under the open part only. */
  .rail-steps {
    display: none;
  }

  .rail-steps a {
    display: block;
    padding: var(--sp-1) var(--sp-2) var(--sp-1) var(--sp-3);
    border-inline-start: 2px solid var(--line);
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .rail-steps a[aria-current='location'] {
    border-inline-start-color: var(--accent);
    color: var(--accent-strong);
    font-weight: 600;
  }

  /* ---------------------------------------- beside the article: a sidebar --- */
  /* Where the article has room for it (ProjectArticle names the layout). */
  @container case-beside (min-width: 0) {
    .case-rail {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--sp-5));
      z-index: 2;
      align-self: start;
      display: block;
      margin: 0;
    }

    .rail-card {
      display: flex;
      flex-direction: column;
      max-block-size: calc(100dvh - var(--header-h) - var(--sp-10));
      box-shadow: var(--shadow-card);
    }

    .rail-head {
      flex: none;
    }

    .rail-parts,
    .rail-steps--page {
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .rail-parts {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .rail-part {
      min-height: 2.25rem;
    }

    .rail-part[aria-current='true'] + .rail-steps,
    .rail-steps--page {
      display: flex;
      flex-direction: column;
      margin: var(--sp-1) 0 var(--sp-2) calc(1.6rem + var(--sp-3) + var(--sp-1));
    }

    .rail-steps--page {
      margin: 0;
      padding: var(--sp-3) var(--sp-3) var(--sp-3) var(--sp-4);
    }

    .rail-steps--page a {
      padding-block: var(--sp-2);
    }
  }

  /* In the overlay the panel scrolls, not the page: stick to its top. */
  @container case-beside (min-width: 0) {
    :global(dialog) .case-rail {
      inset-block-start: var(--sp-4);
    }

    :global(dialog) .rail-card {
      max-block-size: calc(80dvh - 6rem);
    }
  }

  @media (pointer: coarse) {
    .rail-part {
      min-height: 2.75rem;
    }

    .rail-steps a {
      padding-block: var(--sp-2);
    }
  }

  @media print {
    .case-rail {
      display: none;
    }
  }
</style>
